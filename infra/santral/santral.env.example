# =============================================================================
# hangel — Santral (WebRTC <-> SIP geçidi) ortam değişkenleri ŞABLONU
# =============================================================================
# Bu dosya git'e GİRER (içinde GERÇEK secret YOKTUR — sadece açıklamalı şablon).
#
# KULLANIM:
#   cp santral.env.example santral.env
#   nano santral.env        # gerçek değerleri doldur
#   sudo bash setup.sh      # setup.sh bu dosyayı okuyup konfiglere yerleştirir
#
# santral.env dosyası .gitignore'dadır; ASLA commit edilmez.
# =============================================================================

# --- Genel ---------------------------------------------------------------
# Geçidin public DNS adı. Cloudflare'de A kaydı ile VM dış IP'sine bağlanır.
# Let's Encrypt sertifikası da bu isme alınır.
DOMAIN=santral.hangel.org

# Certbot için iletişim e-postası (sertifika yenileme uyarıları buraya gelir).
LETSENCRYPT_EMAIL=ismailhilmi@hangel.org

# =============================================================================
# KİRACI 1: Sosyal Fayda Derneği  (Pasifik trunk)
# =============================================================================
# Pasifik operatör SIP sunucusu (BYOC — dernek kendi lisanslı hattını getirdi).
PASIFIK_HOST=185.77.91.103
PASIFIK_PORT=5060

# Pasifik tarafındaki dahili 100 (Kullanıcı İlişkileri) — kayıt/auth bilgileri.
# Diğer dahililer: 101-105 (gerekirse benzer bloklar ekle).
PASIFIK_EXT_100=100
PASIFIK_PWD_100=                 # <-- GERÇEK SIP ŞİFRESİ — buraya doldur, commit etme

# Bu kiracının tarayıcı (WebRTC) endpoint kimliği ve şifresi.
# Tarayıcıdaki SIP.js bu bilgilerle WSS üzerinden geçide kaydolur.
TENANT1_WEBRTC_USER=sosyalfayda-100
TENANT1_WEBRTC_PWD=              # <-- panel/SIP.js client şifresi — doldur, commit etme

# Bu kiracıya atanan gelen DID numarası (E.164, baş sıfır yok).
TENANT1_DID=902167080216

# =============================================================================
# coturn (TURN/STUN)
# =============================================================================
# YÖNTEM A (önerilen): paylaşılan secret (use-auth-secret).
# SIP.js / tarayıcı, zaman-sınırlı (HMAC) credential üretmek için bunu kullanır.
# Üretmek için:  openssl rand -hex 32
TURN_SECRET=                     # <-- doldur, commit etme

# YÖNTEM B (alternatif): statik kullanıcı/şifre.
# Yöntem A kullanıyorsan bunları boş bırak.
TURN_USER=
TURN_PWD=
