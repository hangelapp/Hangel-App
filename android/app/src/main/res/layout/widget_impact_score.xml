<?xml version="1.0" encoding="utf-8"?>
<!-- Etki Puanım widget'ı (iOS ImpactScoreWidget paritesi, 2x2).
     Üst: küçük "hangel" wordmark + "Etki Puanım" kicker. Orta: büyük coral puan +
     "puan". Alt: rütbe etiketi (yumuşak coral kapsül). Değerler runtime'da
     SharedPreferences("hangel_widget")'tan doldurulur. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/impact_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_container_bg"
    android:padding="14dp">

    <!-- Üst başlık: wordmark + kicker -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_widget_spark"
            android:contentDescription="@string/widget_impact_label" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/widget_impact_kicker"
            android:textColor="@color/widget_text_secondary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_wordmark"
            android:textColor="@color/hangel_coral"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Orta: büyük puan + "puan" -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="start|center_vertical">

        <TextView
            android:id="@+id/impact_score_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="0"
            android:textColor="@color/hangel_coral"
            android:textSize="40sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_impact_unit"
            android:textColor="@color/widget_text_secondary"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Alt: rütbe kapsülü -->
    <TextView
        android:id="@+id/impact_rank"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_tile_bg_coral"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="@string/widget_impact_default_rank"
        android:textColor="@color/hangel_coral"
        android:textSize="11sp"
        android:textStyle="bold" />

</LinearLayout>
