<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- App Links: hangel.org.tr links open Hangel app directly (Android verifies
                 via .well-known/assetlinks.json on the domain at install time). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="hangel.org.tr" />
                <data android:scheme="https" android:host="www.hangel.org.tr" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

        <!-- ===== Home-screen App Widget'ları (iOS WidgetKit ile parite) ===== -->
        <!-- hangel Hızlı Erişim: 4 hızlı eylem, her biri hangel.org.tr App Link açar. -->
        <receiver
            android:name="com.hangel.app.widgets.QuickAccessWidget"
            android:exported="false"
            android:label="@string/widget_quick_access_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_quick_access_info" />
        </receiver>

        <!-- hangel markalı widget: wordmark + tagline → hangel.org.tr ana sayfa. -->
        <receiver
            android:name="com.hangel.app.widgets.BrandWidget"
            android:exported="false"
            android:label="@string/widget_brand_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_brand_info" />
        </receiver>

        <!-- Etki Puanım widget'ı (DİNAMİK): SharedPreferences("hangel_widget")'tan
             etki puanı + rütbe okur. HangelWidget.setData(...) yeniler. -->
        <receiver
            android:name="com.hangel.app.widgets.ImpactScoreWidget"
            android:exported="false"
            android:label="@string/widget_impact_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_impact_score_info" />
        </receiver>

        <!-- Yaklaşan Etkinlik widget'ı (DİNAMİK): SharedPreferences("hangel_widget")'tan
             etkinlik adı + başlangıç + şehir okur, kalan süreyi gösterir. -->
        <receiver
            android:name="com.hangel.app.widgets.UpcomingEventWidget"
            android:exported="false"
            android:label="@string/widget_upcoming_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_upcoming_event_info" />
        </receiver>
    </application>

    <!-- Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- Location: yakın etkinlik / STK / gönüllü ihtiyaçları -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Notifications: Android 13+ runtime permission -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Camera + photo: profil fotoğrafı, etkinlik görselleri -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Photo library: Android 13+ granular, eski versiyonlar için READ_EXTERNAL_STORAGE -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
</manifest>
