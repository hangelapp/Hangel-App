rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Yardımcı fonksiyonlar
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isSuperAdmin() {
      return isSignedIn() && request.auth.token.role == 'super-admin';
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // OTP kodları - sadece server-side erişim (Admin SDK)
    match /otp_codes/{docId} {
      allow read, write: if false;
    }

    // Magic login link tokens (WhatsApp link auth) - server-side only.
    match /login_links/{docId} {
      allow read, write: if false;
    }

    // Device-link tokens (WhatsApp UTILITY "cihaz bağlama") - server-side only.
    match /device_links/{docId} {
      allow read, write: if false;
    }

    // P1-1b: Dağıtık rate-limit kovaları — yalnızca Admin SDK yazar/okur
    // (server-side route'lardan `checkRateLimit()` çağrısı). Client tarafı
    // hiçbir erişim izni almaz; Admin SDK rules'ı bypass eder.
    match /rateLimits/{bucketId} {
      allow read, write: if false;
    }

    // Kullanıcı koleksiyonu
    // SEC-2026-05-25: Privilege-escalation hardening. Owner kendi user docunu
    // güncelleyebilir AMA security-gate alanlarını DEĞİŞTİREMEZ:
    //   role, superAdminPermissions, managed{Ngo,Brand,Club}Id
    // Bu alanlar yalnızca super-admin (UI veya Admin SDK) tarafından set edilir.
    // Aksi halde kullanıcı kendi user docuna `managedNgoId: '<anyOrg>'` yazarak
    // başka kurumun rules-gated update'lerini hijack edebilir
    // (NGO/marka/kulüp update + ngoSenders + messaging + msgs).
    function userPrivilegedFields() {
      return ['role', 'superAdminPermissions',
              'managedNgoId', 'managedBrandId', 'managedClubId'];
    }
    // Non-privileged 'role' values allowed on self-signup (display label only,
    // not a security gate). Admin/super-admin/managed-* roles set server-side.
    function isAllowedSignupRole(role) {
      return role in ['user', 'volunteer', 'donor', 'student', 'individual'];
    }
    match /users/{userId} {
      allow read: if isSignedIn();
      // Create: only own user doc. May set 'role' to a non-privileged value
      // (user/volunteer/donor/student/individual); privileged ownership fields
      // (managed*Id, superAdminPermissions) only via server-side Admin SDK.
      allow create: if isSignedIn() && isOwner(userId) &&
        (!('role' in request.resource.data) || isAllowedSignupRole(request.resource.data.role)) &&
        !request.resource.data.keys().hasAny(['superAdminPermissions', 'managedNgoId', 'managedBrandId', 'managedClubId']);
      // Update: super-admin everything; owner can update self EXCEPT privileged fields.
      allow update: if isSuperAdmin() || (
        isSignedIn() && isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(userPrivilegedFields())
      );
      allow delete: if isSuperAdmin();

      // SECURITY FIX 2026-05-27: fcmTokens push notification tokenları içerir
      // (push token = o cihaza notification gönderme yetkisi). Sadece kullanıcı
      // kendisi ve super-admin okuyabilmeli. Wide-open subcollection read
      // bypass için specific match önce.
      match /fcmTokens/{tokenId} {
        allow read, list: if isSignedIn() && (isOwner(userId) || isSuperAdmin());
        allow write: if isSignedIn() && (isOwner(userId) || isSuperAdmin());
      }

      match /{allChildren=**} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && (isOwner(userId) || isSuperAdmin());
      }
    }

    // Çağrı merkezi (sanal santral) durumu — panel client'tan status/Caller ID okur.
    // Okuma: super-admin VEYA STK'sını yöneten ngo-admin (managedNgoId == ngoId).
    // Yazma: yalnızca Admin SDK (onboard/settings/activate route'ları) — client'a kapalı.
    function canReadCallCenter(ngoId) {
      return isSuperAdmin()
        || (isSignedIn() && request.auth.token.email == 'ismailhilmi@hangel.org')
        || (isSignedIn()
            && exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.managedNgoId == ngoId);
    }
    match /ngoCallCenter/{ngoId} {
      allow read: if canReadCallCenter(ngoId);
      allow write: if false;
      match /{sub=**} {
        allow read: if canReadCallCenter(ngoId);
        allow write: if false;
      }
    }

    // Çağrı oturumları — dashboard KPI/geçmiş client'tan okur (doc'ta ngoId alanı var).
    // Okuma: super-admin/sahip her STK; ngo-admin yalnız kendi ngoId'sini. Yazma: Admin SDK.
    match /callSessions/{sessionId} {
      allow read: if isSuperAdmin()
        || (isSignedIn() && request.auth.token.email == 'ismailhilmi@hangel.org')
        || (isSignedIn()
            && exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.managedNgoId == resource.data.ngoId);
      allow write: if false;
      match /{sub=**} {
        allow read: if isSignedIn();
        allow write: if false;
      }
    }

    // Santral paket listesi + numara havuzu — onboarding wizard client'tan okur (hassas değil).
    match /santralPackages/{pkgId} {
      allow read: if isSignedIn();
      allow write: if false;
    }
    match /santralNumberPool/{numId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // STK'lar, Markalar, Gönderiler, Gönüllülük, Etkinlikler ve Kütüphane - Giriş yapanlar okuyabilir ve listeleyebilir
    // PDF-15: Bazı kayıtlarda adminUserId boş; kullanıcı users/{uid}.managedNgoId üzerinden
    // eşleştiriliyor. managedNgoId fallback inline pattern (storage.rules ile uyumlu).
    match /ngos/{ngoId} {
      allow read, list: if true; // Public for marketplace
      // Super-admin: seed import + manuel ekleme için tam yetki
      allow create, delete: if isSuperAdmin();
      // Herkes sadece viewCount alanını artırabilir (görüntülenme sayacı)
      // VEYA: NGO admin (adminUserId match VEYA managedNgoId fallback) kendi STK'sını tam günceller
      allow update: if isSuperAdmin()
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount'])
        || (isSignedIn()
          // Gate (featureFlags) yalnız super-admin/Admin SDK ile yazılır; STK kendi
          // gate'ini (örn. bulkMailEnabled) client'tan AÇAMAZ.
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['featureFlags'])
          && (
          resource.data.adminUserId == request.auth.uid
          || (exists(/databases/$(database)/documents/users/$(request.auth.uid))
              && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.managedNgoId == ngoId)
        ));
    }

    match /brands/{brandId} {
      allow read, list: if true; // Public read access for marketplace
      // Super-admin: seed import + manuel ekleme için tam yetki
      allow create, delete: if isSuperAdmin();
      // Marka admin (adminUserId match VEYA managedBrandId fallback) kendi markasını günceller
      allow update: if isSuperAdmin() || (isSignedIn() && (
        resource.data.adminUserId == request.auth.uid
        || (exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.managedBrandId == brandId)
      ));
    }

    // Ürün kütüphanesi (feed ingest) — public read (Market ürün listeleme),
    // yazma yalnız super-admin / Admin SDK (feed ingest route). Kullanıcı yazamaz.
    match /products/{productId} {
      allow read, list: if true;
      allow write: if isSuperAdmin();
    }

    // Öğrenci kulüpleri (public read, super-admin global write)
    match /clubs/{clubId} {
      allow read, list: if true;
      // Super-admin: seed import + manuel ekleme için tam yetki
      allow create, delete: if isSuperAdmin();
      // Owners (adminUserId match VEYA managedClubId fallback) kendi kulübünü güncelleyebilir
      allow update: if isSuperAdmin() || (isSignedIn() && (
        resource.data.adminUserId == request.auth.uid
        || (exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.managedClubId == clubId)
      ));
    }

    // Eski adlandırma — uyumluluk için (boşalsın diye)
    match /studentClubs/{clubId} {
      allow read, list: if true;
    }

    match /posts/{postId} {
      allow read, list: if true; // Public for timeline

      // Wave 6-7: posts can be authored AS an org. The top-level authorId is the
      // ORG id (ngo/brand/club doc id), NOT the publishing user's uid. The publisher
      // is a user who manages that org — either the org doc's adminUserId == uid, or
      // the user doc's managed{Ngo,Brand,Club}Id == authorId (managed*Id fallback
      // pattern, consistent with ngos/brands/clubs update rules + ngoSenders).
      function managesOrg(orgId) {
        return isSignedIn() && (
          (exists(/databases/$(database)/documents/ngos/$(orgId))
            && get(/databases/$(database)/documents/ngos/$(orgId)).data.adminUserId == request.auth.uid)
          || (exists(/databases/$(database)/documents/brands/$(orgId))
            && get(/databases/$(database)/documents/brands/$(orgId)).data.adminUserId == request.auth.uid)
          || (exists(/databases/$(database)/documents/clubs/$(orgId))
            && get(/databases/$(database)/documents/clubs/$(orgId)).data.adminUserId == request.auth.uid)
          || (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.managedNgoId == orgId
              || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.managedBrandId == orgId
              || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.managedClubId == orgId
            ))
        );
      }

      // Faz 1-C: Sadece STK/Marka/Kulüp adına paylaşım. Normal kullanıcı
      // (authorId == request.auth.uid) artık post oluşturamaz — yalnızca
      // org-managed post veya super-admin geçerli.
      allow create: if isSuperAdmin() || (isSignedIn() && managesOrg(request.resource.data.authorId));
      // Update/delete: original author, the org's managing user, or super-admin.
      allow update, delete: if isSuperAdmin() || (isSignedIn() && (
        resource.data.authorId == request.auth.uid
        || managesOrg(resource.data.authorId)
      ));

      // PDF-7-likes-rule: per-user like subcollection (doc id = liker uid).
      // Each like is one doc owned by the liker; counts are derived via aggregate.
      // Public read so anon timeline scroll can see like counts; only the liker
      // creates/deletes their own like; updates are forbidden (no mutable fields).
      match /likes/{uid} {
        allow read, list: if true;
        allow create, delete: if isSignedIn() && request.auth.uid == uid;
        allow update: if false;
      }
    }

    // ngoId = STK doküman id'si (auth.uid DEĞİL). Sahiplik projedeki standart
    // pattern ile doğrulanır: users/{uid}.managedNgoId == ngoId. Eski kural
    // `ngoId == request.auth.uid` idi ve STK doc id ile uid karıştığı için
    // client-side güncellemeler (volunteerCount.approved, yayına/pasife alma)
    // sessizce PERMISSION_DENIED alıyordu.
    function ownsNgoListing(ngoId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.managedNgoId == ngoId;
    }
    match /volunteering/{oppId} {
      allow read, list: if true; // Public volunteering listings
      // NGO admins can create listings owned by their own managed NGO.
      allow create: if isSuperAdmin() || ownsNgoListing(request.resource.data.ngoId);
      // Owners update/delete their own listings; super-admin full access.
      // Ayrıca bu ilana ÖZEL atanmış yönetici (managerUids) yazma yetkisi kazanır.
      allow update, delete: if isSuperAdmin() || ownsNgoListing(resource.data.ngoId)
        || (isSignedIn() && resource.data.managerUids != null && request.auth.uid in resource.data.managerUids);
      // Gönüllülük foto galerisi — etkinliktekiyle aynı: public read, giriş yapan yükler.
      match /photos/{photoId} {
        allow read, list: if true;
        allow create: if isSignedIn() && request.resource.data.uploaderUid == request.auth.uid;
        allow update: if isSignedIn() && resource.data.uploaderUid == request.auth.uid;
        allow delete: if isSignedIn() && (resource.data.uploaderUid == request.auth.uid || isSuperAdmin());
      }
      // Kurumsal katılımcı başvuruları — herkes başvurabilir (pending); iletişim bilgisi
      // içerdiğinden yalnız STK yöneticisi/süper-admin okur/onaylar/siler.
      match /corporateApplications/{appId} {
        allow create: if request.resource.data.status == 'pending';
        allow read, list, update, delete: if isSuperAdmin() || ownsNgoListing(get(/databases/$(database)/documents/volunteering/$(oppId)).data.ngoId);
      }
    }

    // Transparency: each NGO admin owns one doc with id == auth uid
    match /transparency/{userId} {
      allow read: if true; // public — used to render transparency score on NGO profile
      allow create, update, delete: if isSignedIn() && isOwner(userId);
    }

    match /eventVenues/{venueId} {
      allow read, list: if true; // Public — mekanlar admin panelinde listelenir
      allow create: if isSignedIn(); // Kulüp/STK admin'i mekan ekleyebilir
      allow update, delete: if isSuperAdmin() ||
        (isSignedIn() && resource.data.createdBy == request.auth.uid);
    }

    // organizerId = STK/kulüp doküman id'si (auth.uid DEĞİL). Sahiplik create
    // kuralındaki pattern ile doğrulanır: organizerId == auth.uid (eski/tek-org)
    // VEYA users/{uid}.managed{Ngo,Club}Id == organizerId. Eski update/delete
    // kuralı yalnız `organizerId == auth.uid` idi → STK/kulüp yöneticisinin
    // client-side etkinlik güncellemesi (ör. managerChecklist) sessizce
    // PERMISSION_DENIED alıyordu.
    function ownsEvent(organizerId) {
      return isSignedIn() && (
        organizerId == request.auth.uid ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.managedClubId == organizerId ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.managedNgoId == organizerId))
      );
    }
    match /events/{eventId} {
      allow read, list: if true; // Public event listings
      // Öğrenci kulüpleri VE STK'lar kendi etkinliklerini oluşturabilir (status='Beklemede').
      allow create: if isSignedIn() &&
        request.resource.data.status == 'Beklemede' &&
        ownsEvent(request.resource.data.organizerId);
      // Sahibi kendi etkinliğini günceller (status DAHIL DEĞIL — super-admin onaylar).
      // Super-admin tüm alanları (status dahil) günceller; spesifik match catch-all'ı override eder.
      allow update: if isSuperAdmin() || (
        ownsEvent(resource.data.organizerId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status'])
      ) || (
        // Bu ilana ÖZEL atanmış yönetici — sahibi gibi status'ü DEĞİŞTİREMEZ.
        resource.data.managerUids != null &&
        request.auth.uid in resource.data.managerUids &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status'])
      );
      allow delete: if isSuperAdmin() || ownsEvent(resource.data.organizerId);

      // FEAT-EVENT-RSVP — server-side write via /api/events/[id]/rsvp.
      // Client can read its own rsvp; super-admin reads all; writes go through Admin SDK.
      match /rsvps/{userId} {
        allow read: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
        allow list: if isSuperAdmin();
        allow write: if false;
      }
      // Etkinlik foto galerisi — herkes görüntüler (public), giriş yapan yükler
      // (uploaderUid kendisi olmalı). Silme: yükleyen ya da süper-admin.
      match /photos/{photoId} {
        allow read, list: if true;
        allow create: if isSignedIn() && request.resource.data.uploaderUid == request.auth.uid;
        allow update: if isSignedIn() && resource.data.uploaderUid == request.auth.uid;
        allow delete: if isSignedIn() && (resource.data.uploaderUid == request.auth.uid || isSuperAdmin());
      }
    }

    // FEAT-REWARD — Ödül/Çekiliş/Quiz PUBLIC banner özeti (doğru cevap İÇERMEZ).
    // Tam yapılandırma + sorular + doğru cevaplar `rewardConfigs` (kural yok →
    // default-deny; yalnız Admin SDK erişir). Yazımlar API (Admin SDK) üzerinden.
    match /eventRewards/{key} {
      allow read, list: if true;
      allow write: if false;
      match /winners/{wid} {
        allow read, list: if true;   // "Kazananlar" herkese görünür (ad + ödül)
        allow write: if false;
      }
    }

    // FEAT-EXAM — Sınav PUBLIC banner özeti (doğru cevap İÇERMEZ). Sorular + doğru
    // cevaplar + sonuçlar `examConfigs` (kural yok → default-deny; yalnız Admin SDK).
    match /eventExams/{key} {
      allow read, list: if true;
      allow write: if false;
    }

    // FEAT-QR-CARD-ACTIVATION — kullanıcı kendi başvuru kaydını oluşturur ve görür;
    // değerlendirmeyi super-admin yapar (status alanını günceller).
    match /qrCardActivations/{actId} {
      allow read: if isSignedIn() && (request.auth.uid == resource.data.userId || isSuperAdmin());
      allow list: if isSuperAdmin();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSuperAdmin();
    }

    // Vakıf/Dernek kütük referans verisi — public-read reference data; yalnızca
    // Admin SDK yazar (scripts/import-registry.mjs, rules'ı bypass eder).
    // Kurumsal kayıt formu auth öncesi sorgulayabildiği için okuma herkese açık.
    match /registryDernekler/{id} { allow read, list: if true; allow write: if false; }
    match /registryVakiflar/{id} { allow read, list: if true; allow write: if false; }

    // Outreach / Tanıtım kontak veritabanı. Super-admin yazar (manuel ekleme +
    // CSV import), super-admin okur. registry koleksiyonlarından farklı —
    // sivil toplum müdürlüğü, kargo şirketleri, mail hizmet sağlayıcıları
    // gibi resmi kütükte olmayan kuruluşlar burada tutulur.
    match /outreachContacts/{id} {
      allow read, list: if isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    // Wave 6A / PDF-72: AI Asistanı promptları/ayarları.
    // /super-admin/ai-management/page.tsx setDoc(doc(db, 'aiAssistantConfig', kind), ...)
    // ile yazıyor. Secret içermez (model adı + persona prompt'u), ancak yine de
    // auth-gated tutuyoruz: yazma yalnız super-admin, okuma giriş yapan kullanıcı.
    // Global allPaths write super-admin'i zaten kapsar; explicit blok defense-in-depth.
    match /aiAssistantConfig/{kind} {
      allow read: if isSignedIn();
      allow list: if isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    // Şeffaflık endeksi kriterleri (super-admin yönetir, herkes okur)
    match /transparencyCriteria/{criterionId} {
      allow read, list: if true;
      allow create, update, delete: if isSuperAdmin();
    }

    // Kan bağışı / acil yardım talepleri (alternatif koleksiyonlar)
    match /bloodRequests/{reqId} {
      allow read, list: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.requestedBy == request.auth.uid;
      allow update, delete: if isSuperAdmin();
    }

    match /userRequests/{reqId} {
      allow read, list: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSuperAdmin();
    }

    match /library/{sectionId} {
      allow read, list: if true; // Public library content
    }

    // Sözleşmeler ve politikalar (super-admin yönetir, herkes okur)
    match /contracts/{contractId} {
      allow read, list: if true;
      allow create, update, delete: if isSuperAdmin();
    }

    // Hukuk yönetim sistemi (super-admin/contracts) — yeni koleksiyonlar
    // Mevzuatlar: imzalı kullanıcı okuyabilir (uyum bilgisi şeffaf), super-admin yazar.
    match /legislations/{legId} {
      allow read, list: if isSignedIn();
      allow create, update, delete: if isSuperAdmin();
    }
    // Kullanıcı onay kayıtları: kullanıcı kendi onayını yazar (immutable — update/delete yok),
    // super-admin tümünü okur. KVKK ispat kaydı.
    match /contractApprovals/{approvalId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read, list: if isSuperAdmin();
      allow update, delete: if false; // değiştirilemez log
    }
    // Sözleşme publish/edit audit log (append-only, super-admin tarafından server'da yazılır).
    // Read: super-admin (panelden geçmişi görür). Client write yasak — yalnızca
    // /api/admin/contracts/publish (Admin SDK) yazar.
    match /contractPublishLog/{logId} {
      allow read, list: if isSuperAdmin();
      allow create, update, delete: if false;
    }
    // Evrak arşivi: kurum admin kendi evrakını yükler, super-admin tümünü görür.
    match /documentArchive/{docId} {
      allow read, list: if isSuperAdmin() || (isSignedIn() && resource.data.uploadedBy == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.uploadedBy == request.auth.uid;
      allow update, delete: if isSuperAdmin();
    }
    // Hukuk chat: sadece super-admin (hukuk görevlileri). Mesaj silinemez.
    match /legalChat/{msgId} {
      allow read, list, create: if isSuperAdmin();
      allow delete: if false;
      allow update: if isSuperAdmin(); // düzenleme loglu (içerik koru, edited flag)
    }
    // Sözleşme×ülke uyum matrisi (1344 doc beklenir: 112 sözleşme × 12 ülke).
    // Read: super-admin (matris panelden okunur). Write: super-admin (AI flow tetikler).
    match /contractCompliance/{rowId} {
      allow read, list: if isSuperAdmin();
      allow create, update, delete: if isSuperAdmin();
    }

    // Hibe programları ve fonlar (super-admin yönetir, herkes okur)
    match /funds/{fundId} {
      allow read, list: if true;
      allow create, update, delete: if isSuperAdmin();
    }

    // Gönüllülük puantajı kataloğu — süper-admin yönetir, herkes okur.
    // NGO admin ilan açarken bu kataloğu okuyup taskType seçer; puanı manuel girmez.
    match /volunteerScoring/{itemId} {
      allow read, list: if true;
      allow create, update, delete: if isSuperAdmin();
    }

    // PDF-17: Hibe başvuruları. NGO admin başvuru oluşturur, kendi başvurularını okur;
    // super-admin tüm başvuruları görür ve karar verir (status alanını günceller).
    // Veri şeması (src/app/ngo-admin/funds/page.tsx#handleApply):
    //   { fundId, fundName, applicantId, applicantNgoId, status, createdAt, message }
    match /fundApplications/{appId} {
      allow read: if isSignedIn() && (
        resource.data.applicantId == request.auth.uid
        || isSuperAdmin()
        || (resource.data.applicantNgoId is string
            && exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.managedNgoId == resource.data.applicantNgoId)
      );
      // List sadece super-admin için açık (NGO scope per-applicant queries client tarafında applicantId == auth.uid ile filtrelenir).
      allow list: if isSuperAdmin() || (
        isSignedIn() && request.query.limit <= 100
      );
      // Create: kullanıcı kendi adına başvurur, applicantId kendi UID'i olmalı.
      allow create: if isSignedIn()
        && request.resource.data.applicantId == request.auth.uid
        && request.resource.data.keys().hasAll(['applicantId', 'fundId', 'status', 'createdAt'])
        && request.resource.data.status == 'Beklemede';
      // Update: başvuru sahibi sadece kendi 'Beklemede'/'draft' başvurusunu düzenleyebilir;
      // status değişimi super-admin yetkisidir.
      allow update: if isSuperAdmin() || (
        isSignedIn()
        && resource.data.applicantId == request.auth.uid
        && resource.data.status in ['Beklemede', 'draft']
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'applicantId', 'fundId', 'createdAt'])
      );
      allow delete: if isSuperAdmin();
    }

    // Site ayarları (anasayfa/about/dernek içerikleri — super-admin yönetir, herkes okur)
    match /siteSettings/{docId} {
      allow read, list: if true;
      allow create, update, delete: if isSuperAdmin();
    }

    // Platform-içi reklam bannerları (super-admin/ads) — super-admin yönetir,
    // herkes okur (banner timeline vb. alanlarda gösterilir).
    match /siteAds/{adId} {
      allow read, list: if true;
      allow create, update, delete: if isSuperAdmin();
    }

    // Market Reklam Alanı banner'ları. Public read (kullanıcıya görünür);
    // yalnızca super-admin yazar. clickCount/impressionCount artışı Admin SDK
    // (/api/ads/*) ile yapılır — kurallar Admin SDK'yı baypas eder.
    match /marketAdBanners/{adId} {
      allow read, list: if true;
      allow create, update, delete: if isSuperAdmin();
    }

    // Süper-admin kişisel panel ayarları — yalnızca super-admin kendi doc'unu okur/yazar.
    // Path: superAdminSettings/{adminUid}. Bildirim tercihleri (notifications.*),
    // gelecekteki başka kişisel ayarlar burada toplanır.
    match /superAdminSettings/{adminUid} {
      allow read, list: if isSuperAdmin() && request.auth.uid == adminUid;
      allow create, update: if isSuperAdmin() && request.auth.uid == adminUid;
      allow delete: if isSuperAdmin() && request.auth.uid == adminUid;
    }

    // Anket cevapları (kullanıcı kendi cevabını yazar; super-admin hepsini görür)
    match /surveys/{surveyId} {
      allow list, read: if isSuperAdmin();
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSuperAdmin();
    }

    // Uygulama değerlendirmeleri / yıldızlar (kullanıcı kendi rating'ini yazar; super-admin hepsini görür)
    match /ratings/{ratingId} {
      allow list, read: if isSuperAdmin();
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSuperAdmin();
    }

    // Bağışlar (kullanıcı kendi alışverişini yazar, kendi bağışlarını okur, super-admin tümünü yönetir)
    // SECURITY FIX 2026-05-27: list per-doc kısıtlı — istemci `where('userId','==',uid)` ile sorgulamalı.
    match /donations/{donationId} {
      allow list: if isSuperAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow read: if isSignedIn() && (
        resource == null ||
        resource.data.userId == request.auth.uid ||
        isSuperAdmin()
      );
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid;
      // Super-admin tüm alanları günceller (status, amounts, payoutDate vb.)
      // Kullanıcı sadece kendi okuma durumunu (read) günceller
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // Destek talepleri (kullanıcı oluşturur ve okur, super-admin tüm talepleri yönetir)
    // SECURITY FIX 2026-05-27: list per-doc kısıtlı — istemci `where('userId','==',uid)` ile sorgulamalı.
    match /supportTickets/{ticketId} {
      allow list: if isSuperAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow read: if isSignedIn() && (
        resource == null ||
        resource.data.userId == request.auth.uid ||
        isSuperAdmin()
      );
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'open';
      // Kullanıcı kendi talebini günceller (sadece message/subject); super-admin her şeyi günceller
      allow update: if isSuperAdmin() || (
        isSignedIn() && resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['subject', 'message', 'updatedAt'])
      );
      allow delete: if isSuperAdmin();
    }

    // Esnek site sayfaları (basın, etkinlik, duyuru — super-admin yönetir, herkes okur)
    match /sitePages/{pageId} {
      allow read, list: if true;
      allow create, update, delete: if isSuperAdmin();
    }

    // Acil durum talepleri
    //  - Kullanıcılar: 'pending' status ile kendi taleplerini oluşturabilir
    //  - Süper Admin: tüm CRUD (onay → 'sent' broadcasts notifications)
    match /emergencyRequests/{reqId} {
      allow read, list: if isSignedIn();
      allow create: if isSuperAdmin() || (
        isSignedIn() &&
        request.resource.data.status == 'pending' &&
        request.resource.data.requestedBy == request.auth.uid
      );
      allow update, delete: if isSuperAdmin();
    }

    // Acil durum yanıtları (kullanıcılar kendi yanıtını oluşturur, süper admin hepsini görür)
    // SECURITY FIX 2026-05-27: list per-doc kısıtlı.
    match /emergencyResponses/{respId} {
      allow list: if isSuperAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow read: if isSignedIn() && (
        resource == null ||
        resource.data.userId == request.auth.uid ||
        isSuperAdmin()
      );
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status in ['positive', 'negative'];
      allow update, delete: if isSuperAdmin() || (
        isSignedIn() && resource.data.userId == request.auth.uid
      );
    }

    // Bildirimler (Süper Admin + NGO admin davetleri yazar; alıcı okur ve okundu işaretler)
    // SECURITY FIX 2026-05-27: list per-doc kısıtlı — istemci `where('userId','==',uid)` ile sorgulamalı.
    match /notifications/{notifId} {
      allow list: if isSuperAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow read: if isSignedIn() && (
        resource == null ||
        resource.data.userId == request.auth.uid ||
        isSuperAdmin()
      );
      // Süper admin her şeyi yazabilir; ayrıca imzalı kullanıcılar:
      //  - 'invitation' tipi (NGO admin → davet ettiği üyeye)
      //  - 'donation' tipi (alışveriş sonrası kendi bildirimi)
      allow create: if isSuperAdmin() || (
        isSignedIn() &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.type in ['invitation', 'donation']
      );
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['read', 'readAt', 'responseStatus', 'respondedAt']);
      allow delete: if isSuperAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // Toplu duyuru parent docs — per-message analytics (gönderildi/okundu özeti).
    // Yalnızca süper admin: oluşturur, okur ve siler.
    match /broadcasts/{broadcastId} {
      allow read, list, create, update, delete: if isSuperAdmin();
    }

    // ----- Toplu SMS & E-Posta sistemi -----

    // Şablonlar (super-admin yönetir; client okur)
    match /messageTemplates/{tplId} {
      allow list, read: if isSuperAdmin();
    }

    // Segmentler (super-admin yönetir)
    match /recipientSegments/{segId} {
      allow list, read: if isSuperAdmin();
    }

    // Kampanyalar + alıcı subcollection (super-admin yönetir)
    match /campaigns/{campaignId} {
      allow list, read: if isSuperAdmin();
      match /recipients/{rid} {
        allow list, read: if isSuperAdmin();
      }
    }

    // Provider konfigleri (super-admin yönetir; secret'lar env'de)
    match /messagingProviders/{key} {
      allow list, read: if isSuperAdmin();
    }

    // CSV upload kayıtları (super-admin yönetir)
    match /csvUploads/{id} {
      allow list, read: if isSuperAdmin();
    }

    // WhatsApp template'leri (super-admin yönetir; Meta'dan senkronlanır)
    match /whatsappTemplates/{id} {
      allow list, read: if isSuperAdmin();
    }

    // Pricing config (super-admin yönetir; herkes okur — fiyat şeffaflığı)
    match /messagingPricing/{id} {
      allow read: if isSignedIn();
    }

    // Kontör paketleri (herkes okuyabilir; super-admin yönetir)
    match /messagingPackages/{id} {
      allow list, read: if isSignedIn();
    }

    // NGO cüzdanları — server-only (Admin SDK üzerinden); NGO admin kendi cüzdanını okur
    match /ngoMessagingWallets/{ngoId} {
      allow read: if isSignedIn() && (
        isSuperAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.managedNgoId == ngoId)
      );
      allow write: if false;
    }

    // STK Workspace Toplu Mail — per-STK SMTP credential (yalnız Admin SDK).
    // adAccounts/metaAccounts deseninin birebir aynısı, AMA explicit default-deny
    // + super-admin read teşhis amaçlı eklenir: smtpPasswordEnc (şifreli App
    // Password) CLIENT'a ASLA dönmemeli. STK admin bile SMTP credential'ı
    // client'tan okuyamaz/yazamaz; bağlama API'leri (connect/disconnect) Admin
    // SDK ile yazar (rules bypass). featureFlags.bulkMailEnabled gate'i ngos doc'u
    // üzerinde tutulur ve yalnız super-admin Admin SDK ile set edilir (ngos update
    // rule client ngo-admin'e kendi doc'unu güncelletse de gate yazımı Admin SDK
    // üzerinden yapılır).
    match /mailAccounts/{ngoId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    // Transactions — server-only; NGO admin kendi NGO'sunun transactions'ını okuyabilir
    match /messagingTransactions/{id} {
      allow list, read: if isSignedIn() && (
        isSuperAdmin() ||
        (resource != null &&
         exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.managedNgoId == resource.data.ngoId)
      );
      allow write: if false;
    }

    // NGO sender'ları — NGO admin kendi sender'larını okur; sadece super-admin onaylar
    match /ngoSenders/{ngoId}/senders/{senderId} {
      allow read, list: if isSignedIn() && (
        isSuperAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.managedNgoId == ngoId)
      );
      // Create: NGO admin pending olarak talep yaratabilir
      allow create: if isSignedIn() &&
        request.resource.data.status == 'pending' &&
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.managedNgoId == ngoId);
      // Update/delete sadece super-admin (global rule kapsar)
    }

    // NGO message templates — NGO admin kendi şablonlarını yönetir
    match /ngoMessageTemplates/{id} {
      allow read, list: if isSignedIn() && (
        isSuperAdmin() ||
        (resource != null &&
         exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.managedNgoId == resource.data.ngoId)
      );
      allow create: if isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.managedNgoId == request.resource.data.ngoId;
      allow update, delete: if isSignedIn() && (
        isSuperAdmin() ||
        (resource != null &&
         exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.managedNgoId == resource.data.ngoId)
      );
    }

    // Payment orders — server-only; NGO admin kendi NGO'sunun order'larını okur
    match /paymentOrders/{id} {
      allow read, list: if isSignedIn() && (
        isSuperAdmin() ||
        (resource != null &&
         exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.managedNgoId == resource.data.ngoId)
      );
      allow write: if false;
    }

    // Invoices — NGO admin kendi NGO'sunun faturalarını okur
    match /messagingInvoices/{id} {
      allow read, list: if isSignedIn() && (
        isSuperAdmin() ||
        (resource != null &&
         exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.managedNgoId == resource.data.ngoId)
      );
      allow write: if false;
    }

    // NGO recipient segments — NGO admin kendi segmentlerini yönetir
    match /ngoRecipientSegments/{id} {
      allow read, list: if isSignedIn() && (
        isSuperAdmin() ||
        (resource != null &&
         exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.managedNgoId == resource.data.ngoId)
      );
      allow create: if isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.managedNgoId == request.resource.data.ngoId;
      allow update, delete: if isSignedIn() && (
        isSuperAdmin() ||
        (resource != null &&
         exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.managedNgoId == resource.data.ngoId)
      );
    }

    // Server-only: gerçek mesaj kuyruğu — Admin SDK ile yazılır/okunur
    match /messageJobs/{id} {
      allow read, write: if false;
    }

    // Server-only: provider webhook event landing
    match /deliveryEvents/{id} {
      allow read, write: if false;
    }

    // Server-only: append-only audit log
    match /messagingAuditLogs/{id} {
      allow list, read: if isSuperAdmin();
      allow create, update, delete: if false;
    }

    // Server-only: rate limit state
    match /messagingRateState/{driver} {
      allow read, write: if false;
    }

    // Server-only: mock provider dev outbox (yalnızca local/dev)
    match /_devOutbox/{id} {
      allow read, write: if false;
    }

    // FEAT-AFFILIATE-WEBHOOK: brand-signed affiliate sale confirmations
    // (Admin SDK only — written by /api/affiliate/webhook/[brandId] after
    //  HMAC SHA256 verification). Doc id is `{brandId}__{orderId}` for
    //  create-or-fail idempotency. No client read/write.
    match /affiliateConfirmations/{confId} {
      allow read, write: if false;
    }

    // KVKK pazarlama izni: sahibi sadece kendi toggle'larını günceller; unsubscribeToken server-only
    match /userMarketingConsent/{userId} {
      allow read: if isSignedIn() && (isOwner(userId) || isSuperAdmin());
      // İlk kez opt-in için create — sadece sahibi, sadece enabled flag'leri ile
      allow create: if isSignedIn() && isOwner(userId) &&
        !('unsubscribeToken' in request.resource.data) &&
        !('iys' in request.resource.data);
      // Update — sahibi sadece email.enabled / sms.enabled / channelAddresses alanlarını değiştirebilir
      allow update: if isSignedIn() && isOwner(userId) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['email', 'sms', 'channelAddresses', 'updatedAt']);
      allow delete: if isSuperAdmin();
    }

    // Yetkili davetiyeleri (NGO admin → mevcut üyeye rol daveti)
    // SECURITY FIX 2026-05-27: list per-doc kısıtlı — invitedBy/inviteeUserId match veya super-admin.
    match /userInvitations/{inviteId} {
      allow list: if isSuperAdmin() || (isSignedIn() && (
        resource.data.invitedBy == request.auth.uid ||
        resource.data.inviteeUserId == request.auth.uid
      ));
      allow read: if isSignedIn() && (
        resource == null ||
        resource.data.invitedBy == request.auth.uid ||
        resource.data.inviteeUserId == request.auth.uid ||
        isSuperAdmin()
      );
      // İki yol: (a) normal davet (status='pending', invitedBy=request.auth.uid)
      //          (b) super-admin direkt yetkilendirme (status='accepted', invitedBy='super-admin')
      // Her iki yolda da invitee mevcut bir user dokümanı olmalı.
      allow create: if isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.resource.data.inviteeUserId)) &&
        (
          (request.resource.data.invitedBy == request.auth.uid &&
           request.resource.data.status == 'pending')
          ||
          (isSuperAdmin() && request.resource.data.status == 'accepted')
        );
      // Sadece davet alan veya davet eden güncelleyebilir/silebilir
      allow update, delete: if isSignedIn() && (
        resource.data.invitedBy == request.auth.uid ||
        resource.data.inviteeUserId == request.auth.uid ||
        isSuperAdmin()
      );
    }

    // Başvuru koleksiyonu
    // SECURITY FIX 2026-05-27: list per-doc kısıtlı — kullanıcı sadece kendi başvurusunu görür.
    match /applications/{appId} {
      // list/read: super-admin; kendi başvurusu; VEYA ilan sahibi STK yöneticisi
      // (başvuruya denormalize edilmiş ngoId, yöneticinin managedNgoId'siyle eşleşirse).
      // Bu son koşul, super-admin OLMAYAN gerçek STK yöneticilerinin başvuru listesini
      // görebilmesi için gereklidir (aksi halde "liste yüklenemedi" hatası alıyorlardı).
      allow list: if isSuperAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid)
        || ownsNgoListing(resource.data.ngoId);
      allow read: if isSignedIn() && (
        resource == null
        || resource.data.userId == request.auth.uid
        || isSuperAdmin()
        || ownsNgoListing(resource.data.ngoId)
      );
      // Corporate registrations (BRAND/CLUB/NGO) can be submitted by anonymous users
      // (onboarding flow runs before account creation). All other app types require auth.
      allow create: if isSignedIn() || (
        request.resource.data.entityType in ['BRAND', 'CLUB', 'NGO'] &&
        request.resource.data.status == 'Beklemede' &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.email is string &&
        request.resource.data.email.size() > 0
      );
      allow update, delete: if isSuperAdmin();
    }

    // FEAT-ENTITY-INBOX: Birebir mesajlar (kullanıcı ↔ kullanıcı / STK / marka / kulüp / yönetici)
    // Veri şeması (src/app/messages/page.tsx):
    //   { sender:{id,name,avatarUrl}, senderId, recipient:{id,name,avatarUrl},
    //     recipientId, subject, content, timestamp, status, readBy:{[uid]:ts} }
    // recipientId bir KULLANICI uid'i ya da bir ENTITY doc id'si (ngo/brand/club) olabilir.
    // Entity'ye gelen mesajları o entity'yi yöneten admin okur (managed*Id fallback pattern —
    // ngoSenders / fundApplications ile uyumlu). Yanıt yazarken senderId == auth.uid kalır
    // (entity yalnızca sender.name/sender.id ile GÖRSEL olarak temsil edilir) → create rule
    // gevşetilmeden entity adına yanıt mümkün.
    match /messages/{messageId} {
      // recipientId, istek sahibinin yönettiği bir entity'ye mi işaret ediyor?
      function recipientIsMyManagedEntity() {
        return exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.managedNgoId == resource.data.recipientId
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.managedBrandId == resource.data.recipientId
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.managedClubId == resource.data.recipientId
        );
      }

      // Wave 6-7 create-hardening helpers. Normal kullanıcı yalnızca bir kuruma
      // (STK/marka/kulüp) ya da bir admin/super-admin kullanıcıya mesaj atabilir;
      // kullanıcı→kullanıcı DM kapalı.
      // recipientId bir entity (ngo/brand/club) doc id'si mi?
      function recipientIsEntity(rid) {
        return exists(/databases/$(database)/documents/ngos/$(rid))
          || exists(/databases/$(database)/documents/brands/$(rid))
          || exists(/databases/$(database)/documents/clubs/$(rid));
      }
      // recipientId bir admin/super-admin kullanıcı mı? (kurum yöneticileri dahil)
      function recipientIsAdminUser(rid) {
        return exists(/databases/$(database)/documents/users/$(rid))
          && get(/databases/$(database)/documents/users/$(rid)).data.role
             in ['super-admin', 'ngo-admin', 'brand-admin', 'club-admin', 'admin'];
      }
      // İstek sahibi bir entity-admin mi? (mevcut thread'lerin korunması: entity-admin
      // bir normal kullanıcıya YANIT verebilmeli — alıcı normal kullanıcı olsa bile.)
      function senderIsEntityAdmin() {
        return exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
              in ['super-admin', 'ngo-admin', 'brand-admin', 'club-admin', 'admin']
            || ('managedNgoId' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data)
            || ('managedBrandId' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data)
            || ('managedClubId' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data)
          );
      }

      // Tekil okuma: alıcı, gönderen, entity-admin veya super-admin.
      allow read: if isSignedIn() && (
        resource == null ||
        resource.data.recipientId == request.auth.uid ||
        resource.data.senderId == request.auth.uid ||
        isSuperAdmin() ||
        recipientIsMyManagedEntity()
      );

      // SECURITY FIX 2026-05-27: list per-doc kısıtlı. Önceki "per-doc gizlilik read ile garanti"
      // yorumu yanlıştı — Firestore list rule per-doc çalışır ama varsa filtreleri devre dışı
      // bırakırsa tüm collection dökülebilir. Şimdi her doc için recipientId/senderId/managed
      // entity kontrolü zorunlu.
      allow list: if isSuperAdmin() || (isSignedIn() && (
        resource.data.recipientId == request.auth.uid ||
        resource.data.senderId == request.auth.uid ||
        recipientIsMyManagedEntity()
      ));

      // Oluşturma: senderId mutlaka istek sahibinin uid'i olmalı (spoof engeli) VE
      // alıcı bir kurum (STK/marka/kulüp) ya da bir admin/super-admin kullanıcı olmalı —
      // normal kullanıcı→normal kullanıcı DM kapalı. Entity-admin, normal kullanıcıya
      // YANIT verebilir (senderIsEntityAdmin) → mevcut thread'ler korunur.
      // Entity adına yanıt: senderId = admin uid, sender.name = entity adı.
      allow create: if isSignedIn()
        && request.resource.data.senderId == request.auth.uid
        && (
          recipientIsEntity(request.resource.data.recipientId)
          || recipientIsAdminUser(request.resource.data.recipientId)
          || senderIsEntityAdmin()
          || isSuperAdmin()
        );

      // Güncelleme: yalnızca okundu bilgisi (`readBy`) eklenebilir; alıcı, entity-admin
      // veya super-admin yapabilir. Başka alanlar değiştirilemez.
      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy'])
        && (
          resource.data.recipientId == request.auth.uid ||
          isSuperAdmin() ||
          recipientIsMyManagedEntity()
        );

      // Silme: super-admin (global allPaths kapsar) — explicit deny diğer herkese.
      allow delete: if isSuperAdmin();
    }

    // SECURITY FIX 2026-05-27: Eksik koleksiyon kuralları (önceden global catch-all
    // tarafından sessizce reddediliyordu → istemci write'ları kırıktı).

    // Timeline post raporları (kullanıcı bildir → super-admin moderasyon)
    match /postReports/{reportId} {
      allow create: if isSignedIn() && request.resource.data.reporterId == request.auth.uid;
      allow read, list: if isSuperAdmin();
      allow update, delete: if isSuperAdmin();
    }

    // /feedback formu (kullanıcı geri bildirim → super-admin inceler)
    match /userFeedback/{feedbackId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read, list: if isSuperAdmin();
      allow update, delete: if isSuperAdmin();
    }

    // E-posta kuyruğu (sadece Admin SDK; istemci hiçbir şey yapamaz)
    match /mailQueue/{mailId} {
      allow read, write: if false;
    }

    // Davet sistemi (kullanıcı arkadaşına davet gönderir; super-admin tümünü görür)
    match /invites/{inviteId} {
      allow create: if isSignedIn() && request.resource.data.invitedBy == request.auth.uid;
      allow read, list: if isSuperAdmin() || (isSignedIn() && (
        resource.data.invitedBy == request.auth.uid ||
        resource.data.inviteeUserId == request.auth.uid
      ));
      allow update, delete: if isSuperAdmin() || (isSignedIn() && resource.data.invitedBy == request.auth.uid);
    }

    // iOS Live Activity push token kayıtları — Faz 1
    // Kullanıcının cihazından native ActivityKit aktivite başlattığında oluşturulan
    // APNs push token'ı. Backend Cloud Function (Faz 1) burayı dinleyip update'leri
    // APNs HTTP/2'ye doğrudan POST eder (FCM Live Activity desteklemiyor).
    match /liveActivityTokens/{tokenId} {
      allow read: if isSignedIn() && (request.auth.uid == resource.data.uid || isSuperAdmin());
      allow list: if isSuperAdmin();
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // Apple Wallet (PassKit) cihaz kayıtları — Faz 1
    // Apple zorunlu update web service'i bu kayıtlardan push token'lara update
    // tetikler. Yalnız backend (Admin SDK) yazar; istemci okuyup yazamaz.
    match /passkitRegistrations/{regId} {
      allow read, list, write: if false;
    }

    // NFC etiket tanımları — Faz 1/2
    // STK adminleri kendi ngoId'sine ait etiket oluşturur; gönüllüler etiket
    // okuma sonucu URL'den ulaşır, doc okumaya gerek yok.
    match /nfcTags/{tagId} {
      allow read: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && (
        isSuperAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.managedNgoId == request.resource.data.ownerNgoId)
      );
      allow update, delete: if isSuperAdmin() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.managedNgoId == resource.data.ownerNgoId
      );
    }

    // Etkinlik check-in sub-collection — Faz 1
    // Path: events/{eventId}/checkins/{uid}. Akıllı check-in (QR/NFC/konum) ile
    // yazılır; geofence exit ile otomatik check-out. Server write (Admin SDK)
    // tercihli — client kendi check-in'ini görebilir.
    //
    // App Clip anonymous check-in (POST /api/clip/checkin): doc id = `dev_<hash>`
    // (hash = SHA-256(deviceId)[:32]). Bu doc Admin SDK üzerinden yazılır (rules
    // bypass) — client write izni gerekmez. Read tarafı: organizer + super-admin
    // mevcut wildcard match'ten yararlanır (uid yerine dev_<hash> doc id'si).
    match /events/{eventId}/checkins/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isSuperAdmin());
      allow list: if isSuperAdmin() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/events/$(eventId)) &&
        get(/databases/$(database)/documents/events/$(eventId)).data.organizerId == request.auth.uid
      );
      // Client create yalnızca authenticated kullanıcı için (uid == auth.uid).
      // App Clip anonymous check-in Admin SDK ile yazılır — rules bypass.
      allow create: if isSignedIn() && request.auth.uid == uid &&
        request.resource.data.uid == request.auth.uid;
      allow update: if isSignedIn() && request.auth.uid == uid;
      allow delete: if isSuperAdmin();
    }

    // Mikro Gönüllülük — Faz 3
    // Görevler: STK admin (managedNgoId) veya super-admin oluşturur; herkes
    // listeyi okur. Tamamlama: kullanıcı kendi kaydını yazar.
    match /microTasks/{taskId} {
      allow read, list: if true;
      allow create: if isSuperAdmin() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.managedNgoId == request.resource.data.ngoId
      );
      allow update, delete: if isSuperAdmin() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.managedNgoId == resource.data.ngoId
      );
    }
    match /microTaskCompletions/{compId} {
      allow read: if isSignedIn() && (request.auth.uid == resource.data.uid || isSuperAdmin());
      allow list: if isSuperAdmin();
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // Gönüllü görev tamamlama kayıtları (Ajan 4/4 — saat + meslek + etki değeri).
    // Akış: kullanıcı kendi adına 'pending' (ngoApproved: false) kayıt açar →
    //       STK admin onaylar (ngoApproved: true) → user stats + sertifika.
    //
    // Read: kayıt sahibi, kaydın bağlı olduğu STK'nın admin'i veya super-admin.
    // Create: yalnızca kullanıcı kendi adına; ngoApproved zorunlu olarak false
    //         (otomatik self-approve engeli).
    // Update: STK admin (managedNgoId == doc.ngoId) veya super-admin.
    // Delete: yalnızca super-admin (audit trail korunur).
    match /volunteerCompletions/{completionId} {
      function isCompletionOwner() {
        return isSignedIn() && resource.data.userId == request.auth.uid;
      }
      function isManagingNgoAdmin() {
        return isSignedIn()
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.managedNgoId == resource.data.ngoId;
      }
      allow read: if isSuperAdmin() || isCompletionOwner() || isManagingNgoAdmin();
      allow list: if isSuperAdmin() || (isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.managedNgoId == resource.data.ngoId)
      ));
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.ngoApproved == false;
      allow update: if isSuperAdmin() || (
        isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.managedNgoId == resource.data.ngoId
      );
      allow delete: if isSuperAdmin();
    }

    // Çift yönlü değerlendirme kayıtları (gönüllü ↔ STK).
    // Doc id deterministik: `${kind}_${refId}_${volunteerId}` (src/lib/evaluations.ts).
    // Doc şekli: { volunteerId, ngoId, kind, refId, createdAt,
    //             volunteerToNgo?: { answers, score, comment, completedAt },
    //             ngoToVolunteer?: { answers, score, comment, completedAt },
    //             certificateUnlocked?: boolean }
    //
    // Read: değerlendirilen gönüllü (volunteerId == auth.uid), kaydın bağlı
    //       olduğu STK'nın admin'i (managedNgoId == doc.ngoId) veya super-admin.
    // Write: client'tan TÜM yazımlar kapalı. Her iki yön de Admin SDK üzerinden
    //        yazılır (api/evaluations/volunteer-to-ngo + ngo-to-volunteer);
    //        Admin SDK rules'ı bypass eder. Böylece "gönüllü yalnız kendi
    //        yönünü, STK yalnız kendi yönünü yazar" kuralı route içinde
    //        zorlanır ve client doğrudan yazıp puan/sertifika kilidini
    //        manipüle edemez (volunteerCompletions deseninin daha sıkı hali).
    match /evaluations/{evalId} {
      function isEvalVolunteer() {
        return isSignedIn() && resource.data.volunteerId == request.auth.uid;
      }
      function isEvalNgoAdmin() {
        return isSignedIn()
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.managedNgoId == resource.data.ngoId;
      }
      allow read: if isSuperAdmin() || isEvalVolunteer() || isEvalNgoAdmin();
      allow list: if isSuperAdmin() || (isSignedIn() && (
        resource.data.volunteerId == request.auth.uid ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.managedNgoId == resource.data.ngoId)
      ));
      allow write: if false; // SADECE Admin SDK (api/evaluations/*) yazar
    }

    // bloodCalls — Acil kan/trombosit/kök hücre ilanları
    // Read: imzalı kullanıcılar görebilir (yardım çağrısı public)
    // Write: sadece NGO admin (managedNgoId == ngoId) veya super-admin
    match /bloodCalls/{callId} {
      allow read, list: if isSignedIn();
      allow create: if isSignedIn() && (
        isSuperAdmin() ||
        (request.auth.token.managedNgoId != null && request.resource.data.ngoId == request.auth.token.managedNgoId)
      );
      allow update: if isSignedIn() && (
        isSuperAdmin() ||
        (request.auth.token.managedNgoId != null && resource.data.ngoId == request.auth.token.managedNgoId)
      );
      allow delete: if isSuperAdmin();
    }

    // disasterAlerts — Afet ve acil durum çağrıları (deprem, sel, yangın)
    // Read: imzalı kullanıcılar (afet bildirimi public yararına)
    // Write: sadece super-admin veya verified emergency coordinator role
    //
    // onCreate trigger (Cloud Functions): onDisasterAlertCreated 50km
    // geofence ile users.lastKnownLocation tarayıp notifications doc'larını
    // Admin SDK ile yazar (rules bypass). geofence audit alanını
    // ({ processedAt, scanned, matched, radiusKm }) Functions update eder.
    match /disasterAlerts/{alertId} {
      allow read, list: if isSignedIn();
      allow create, update: if isSuperAdmin() || (
        isSignedIn() && request.auth.token.role == 'emergency-coordinator'
      );
      allow delete: if isSuperAdmin();
    }

    // events/{eventId}/checkins/{uid} subcollection için ek auto-checkin
    // path — eventCheckins COLLECTIONS yapısı zaten yukarıda match var,
    // bu sadece smart check-in webhook için iddempotency kuralı.
    // (Mevcut events/{eventId}/checkins kuralı satır 872'de yeterli.)

    // hospitals — OSM ve Sağlık Bakanlığı kaynaklı hastane kataloğu (~5013 doc).
    // Read: super-admin (admin paneli liste/edit). Public arama
    // (/api/hospitals/lookup) Admin SDK ile çalışır → rules bypass.
    // Write: yalnızca super-admin (UI'den manuel düzeltme; toplu import
    // Admin SDK ile yapılır, rules bypass).
    match /hospitals/{hospitalId} {
      allow read, list: if isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    // Onboarding funnel analytics — kayıt/onboarding adım olayları (view/complete/skip).
    // Pre-auth funnel: register/verify_sent/intent adımları henüz oturum açılmadan
    // tetiklenebildiği için create herkese açıktır (anonim). Kötüye kullanımı sınırlamak
    // için yalnızca beklenen alanlar + geçerli step/action enum'u kabul edilir.
    // Okuma yalnızca super-admin (terk analizi paneli). Güncelleme/silme yasak (append-only).
    match /onboardingEvents/{eventId} {
      allow read, list: if isSuperAdmin();
      allow create: if
        request.resource.data.step in
          ['register', 'verify_sent', 'intent', 'ngo_selection', 'profile', 'volunteer_prefs', 'completed'] &&
        request.resource.data.action in ['view', 'complete', 'skip'];
      allow update, delete: if false;
    }

    // WhatsApp Business (WABA) — multi-tenant.
    // Read: STK kendi ngoId'sinin docları + super-admin. Write: yalnızca
    // Admin SDK (api/whatsapp/* + webhook). Client doğrudan yazamaz çünkü
    // accessToken/wamid + Meta API ile koordinasyon gerekiyor.
    match /wabaPhoneNumbers/{id} {
      allow read: if isSignedIn() && (
        resource.data.ngoId == request.auth.token.managedNgoId ||
        isSuperAdmin()
      );
      allow write: if false;
    }
    match /wabaTemplates/{id} {
      allow read: if isSignedIn() && (
        resource.data.ngoId == request.auth.token.managedNgoId ||
        isSuperAdmin()
      );
      allow write: if false;
    }
    match /wabaConversations/{id} {
      allow read: if isSignedIn() && (
        resource.data.ngoId == request.auth.token.managedNgoId ||
        isSuperAdmin()
      );
      allow write: if false;
      match /messages/{msgId} {
        allow read: if isSignedIn() && (
          get(/databases/$(database)/documents/wabaConversations/$(id)).data.ngoId == request.auth.token.managedNgoId ||
          isSuperAdmin()
        );
        allow write: if false;
      }
    }

    // Tanıtım Araçları (pazarlama materyalleri) — super-admin yönetir + onay akışı.
    // status: 'taslak' (yalnız super-admin) | 'yayinda' (onaylı). publicListed =
    // (status=='yayinda' && isPublic) — yazarken türetilir.
    //   • super-admin: hepsini okur (taslak dahil)
    //   • giriş yapmış org-admin: 'yayinda' olanları okur (panel client tarafında
    //     targetKinds'e göre filtreler) → query: where('status','==','yayinda')
    //   • kimliksiz konferans ziyaretçisi: yalnız publicListed==true → /tanitim
    //     query: where('publicListed','==',true) (kompozit index gerekmez)
    // Yazma: yalnız super-admin (aşağıdaki global kural da kapsar; açıkça yazıyoruz).
    match /marketingAssets/{assetId} {
      allow read, list: if isSuperAdmin()
        || (resource != null && resource.data.publicListed == true)
        || (isSignedIn() && resource != null && resource.data.status == 'yayinda');
      allow write: if isSuperAdmin();
    }

    // Global Yazma Erişimi (Sadece Super Admin)
    match /{allPaths=**} {
      allow write: if isSuperAdmin();
    }
  }
}