rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Yardımcı fonksiyonlar
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    function isSuperAdmin() {
      return request.auth.token.email == '5384009090@hangel.org';
    }

    // Kullanıcı koleksiyonu kuralları
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write, update: if isSignedIn() && (isOwner(userId) || isSuperAdmin());
      
      match /{allChildren=**} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && (isOwner(userId) || isSuperAdmin());
      }
    }

    // Diğer tüm koleksiyonlar için global kural
    // Süper Admin her şeyi yapabilir, giriş yapanlar okuyabilir/yazabilir (başvuru vb için)
    match /{allPaths=**} {
      allow read, write: if isSignedIn();
    }
    
    // Sistem watcher tetikleyici: Yetki hiyerarşisi ve Super Admin erişimi tam kapasiteye çıkarıldı.
    // Son güncelleme: 2024-07-23 21:45
  }
}