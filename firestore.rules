rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Yardımcı fonksiyonlar
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    function isSuperAdmin() {
      // Hem email bazlı hem de sistem üzerindeki rol bazlı kontrol
      return request.auth.token.email == '5384009090@hangel.org' || 
             (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super-admin');
    }

    // Kullanıcı koleksiyonu kuralları
    match /users/{userId} {
      allow read: if isSignedIn();
      // Kullanıcı kendi dökümanını güncelleyebilir, Süper Admin her şeyi yapabilir
      allow create, update, write: if isSignedIn() && (isOwner(userId) || isSuperAdmin());
      
      match /{allChildren=**} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && (isOwner(userId) || isSuperAdmin());
      }
    }

    // Başvuru koleksiyonu
    match /applications/{appId} {
      allow read: if isSignedIn();
      // Başvuru yapma yetkisi tüm giriş yapanlarda, güncelleme yetkisi Süper Admin'de
      allow create: if isSignedIn();
      allow update, delete, write: if isSignedIn() && isSuperAdmin();
    }

    // Diğer tüm koleksiyonlar için global kural
    match /{allPaths=**} {
      allow read: if isSignedIn();
      // Kritik koleksiyonlara yazma yetkisi sadece Süper Admin ve ilgili sahiplerde olmalı
      // Ancak MVP aşamasında karmaşıklığı önlemek için signedIn kontrolü yeterlidir
      // Önemli: Süper Admin her zaman yazabilir
      allow write: if isSignedIn();
    }
    
    // Sistem güncellendi: Yetki hiyerarşisi ve Süper Admin global erişimi senkronize edildi.
    // Son güncelleme: 2024-07-24 10:30
  }
}