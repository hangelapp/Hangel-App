rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- User Data Ownership ---
    match /users/{userId} {
      allow get, list, create, update, delete: if isOwner(userId);

      match /impactScore/{document} {
        allow get, list, create, update, delete: if isOwner(userId);
      }

      match /badges/{badgeId} {
        allow get, list, create, update, delete: if isOwner(userId);
      }

      match /certificates/{certId} {
        allow get, list, create, update, delete: if isOwner(userId);
      }

      match /qrCodePayments/{paymentId} {
        allow get, list, create, update, delete: if isOwner(userId);
      }
    }

    // --- Organization Profiles (Publicly Readable) ---
    match /ngos/{ngoId} {
      allow get, list: if true;
      allow write: if isOwner(ngoId); // NGO Admin access

      match /timelinePosts/{postId} {
        allow get, list: if true;
        allow write: if isOwner(ngoId);
      }

      match /volunteerOpportunities/{oppId} {
        allow get, list: if true;
        allow write: if isOwner(ngoId);
      }
    }

    match /brands/{brandId} {
      allow get, list: if true;
      allow write: if isOwner(brandId); // Brand Admin access
    }

    // --- Discovery & Events ---
    match /events/{eventId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && resource.data.organizerId == request.auth.uid;
    }

    match /emergencyAssistance/{emergencyAssistanceId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && resource.data.requesterId == request.auth.uid;
    }
  }
}
