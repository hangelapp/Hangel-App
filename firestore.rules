rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Yardımcı fonksiyonlar
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.email == '5384009090@hangel.org' || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super-admin')
      );
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Kullanıcı koleksiyonu
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (isOwner(userId) || isSuperAdmin());
      allow delete: if isSuperAdmin();
      
      match /{allChildren=**} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && (isOwner(userId) || isSuperAdmin());
      }
    }

    // STK'lar, Markalar, Gönderiler, Gönüllülük ve Etkinlikler - Giriş yapanlar okuyabilir
    match /ngos {
      allow read, list: if isSignedIn();
    }
    match /ngos/{document=**} {
      allow read, get, list: if isSignedIn();
    }

    match /brands {
      allow read, list: if isSignedIn();
    }
    match /brands/{document=**} {
      allow read, get, list: if isSignedIn();
    }

    match /posts {
      allow read, list: if isSignedIn();
    }
    match /posts/{document=**} {
      allow read, get, list: if isSignedIn();
    }

    match /volunteering {
      allow read, list: if isSignedIn();
    }
    match /volunteering/{document=**} {
      allow read, get, list: if isSignedIn();
    }

    match /events {
      allow read, list: if isSignedIn();
    }
    match /events/{document=**} {
      allow read, get, list: if isSignedIn();
    }

    // Başvuru koleksiyonu
    match /applications {
      allow list: if isSignedIn();
    }
    match /applications/{appId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || isSuperAdmin());
      allow create: if isSignedIn();
      allow update, delete: if isSuperAdmin();
    }

    // Global Yazma Erişimi (Sadece Super Admin)
    match /{allPaths=**} {
      allow write: if isSuperAdmin();
    }
  }
}
