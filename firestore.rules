rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Geliştirme aşamasında, giriş yapmış her kullanıcıya tüm koleksiyonlar için tam erişim veriyoruz.
    // Bu, Super Admin panelindeki listeleme (list) ve okuma (get) hatalarını kesin olarak çözer.
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
    
    // Sistem watcher tetikleyici: Yetki kuralları global olarak en kapsayıcı hale getirildi.
    // Bu kural /users, /applications, /ngos ve diğer tüm koleksiyonlardaki 'list' hatalarını giderir.
    // Son güncelleme: 2024-07-23 16:45
  }
}