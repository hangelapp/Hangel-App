rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Yardımcı Fonksiyonlar ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- Kullanıcı Verileri ---
    match /users/{userId} {
      // Bireysel döküman erişimi (get, create, update, delete)
      allow get, write: if isOwner(userId);
      
      // Admin paneli sayaçları ve listeleme için izin
      // Super Admin panelinde tüm kullanıcıları sayabilmek ve listelemek için list izni gereklidir.
      allow list: if isSignedIn();

      // Alt koleksiyonlar (badges, certificates, qrCodePayments vb.)
      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // --- STK Profilleri ---
    match /ngos/{ngoId} {
      allow read: if true;
      allow write: if isSignedIn();

      match /{allSubcollections=**} {
        allow read: if true;
        allow write: if isSignedIn();
      }
    }

    // --- Marka Profilleri ---
    match /brands/{brandId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // --- Zaman Tüneli Gönderileri ---
    match /posts/{postId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // --- Gönüllülük İlanları ---
    match /volunteering/{oppId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // --- Kütüphane İçerikleri ---
    match /library/{sectionId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // --- Başvurular ---
    match /applications/{appId} {
      // Super Admin panelinde başvuruları listelemek ve saymak için 'read' (get + list) izni gereklidir.
      allow read, write: if isSignedIn();
    }

    // --- Etkinlikler ---
    match /events/{eventId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // --- Acil Durum Bildirimleri ---
    match /emergencyAssistance/{emergencyAssistanceId} {
      allow read: if true;
      allow write: if isSignedIn();
    }
  }
}