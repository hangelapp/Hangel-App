
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Yardımcı Fonksiyonlar ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- Kullanıcı Verileri ---
    // Geliştirme aşamasında Super Admin sayımı için listeleme izni signedIn kullanıcılara verildi
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId);
      
      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // --- STK Profilleri ---
    match /ngos/{ngoId} {
      allow read: if true;
      allow write: if isSignedIn();

      match /{allSubcollections=**} {
        allow read: if true;
        allow write: if isSignedIn();
      }
    }

    // --- Marka Profilleri ---
    match /brands/{brandId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // --- Zaman Tüneli Gönderileri ---
    match /posts/{postId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // --- Gönüllülük İlanları ---
    match /volunteering/{oppId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // --- Kütüphane İçerikleri ---
    match /library/{sectionId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // --- Başvurular ---
    // Super Admin listelemesi için read (get+list) izni eklendi
    match /applications/{appId} {
      allow read, write: if isSignedIn();
    }

    // --- Etkinlikler ---
    match /events/{eventId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // --- Acil Durum Bildirimleri ---
    match /emergencyAssistance/{emergencyId} {
      allow read: if true;
      allow write: if isSignedIn();
    }
    
    // Sistem watcher tetikleyici yorum satırı.
    // Yetkilendirme mimarisi koleksiyon listeleme hatalarını gidermek için sadeleştirildi.
  }
}
