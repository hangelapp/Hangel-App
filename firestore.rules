rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Yardımcı fonksiyonlar
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.email == '5384009090@hangel.org' || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super-admin')
      );
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // OTP kodları - sadece server-side erişim (Admin SDK)
    match /otp_codes/{docId} {
      allow read, write: if false;
    }

    // Kullanıcı koleksiyonu
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (isOwner(userId) || isSuperAdmin());
      allow delete: if isSuperAdmin();
      
      match /{allChildren=**} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && (isOwner(userId) || isSuperAdmin());
      }
    }

    // STK'lar, Markalar, Gönderiler, Gönüllülük, Etkinlikler ve Kütüphane - Giriş yapanlar okuyabilir ve listeleyebilir
    match /ngos/{ngoId} {
      allow read, list: if true; // Public for marketplace
      // Herkes sadece viewCount alanını artırabilir (görüntülenme sayacı)
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount']);
    }

    match /brands/{brandId} {
      allow read, list: if true; // Public read access for marketplace
    }

    match /posts/{postId} {
      allow read, list: if true; // Public for timeline
    }

    match /volunteering/{oppId} {
      allow read, list: if true; // Public volunteering listings
      // NGO admins can create listings owned by their own NGO (ngoId == auth uid)
      allow create: if isSignedIn() && request.resource.data.ngoId == request.auth.uid;
      // Owners can update/delete their own listings; super-admin has full access via global rule
      allow update, delete: if isSignedIn() && resource.data.ngoId == request.auth.uid;
    }

    // Transparency: each NGO admin owns one doc with id == auth uid
    match /transparency/{userId} {
      allow read: if true; // public — used to render transparency score on NGO profile
      allow create, update, delete: if isSignedIn() && isOwner(userId);
    }

    match /events/{eventId} {
      allow read, list: if true; // Public event listings
    }

    match /library/{sectionId} {
      allow read, list: if true; // Public library content
    }

    // Başvuru koleksiyonu
    match /applications/{appId} {
      allow list: if isSignedIn();
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || isSuperAdmin());
      allow create: if isSignedIn();
      allow update, delete: if isSuperAdmin();
    }

    // Global Yazma Erişimi (Sadece Super Admin)
    match /{allPaths=**} {
      allow write: if isSuperAdmin();
    }
  }
}