rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Yardımcı fonksiyonlar
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isSuperAdmin() {
      return request.auth.token.email == '5384009090@hangel.org' || 
             (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super-admin');
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Kullanıcı koleksiyonu
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (isOwner(userId) || isSuperAdmin());
      allow delete: if isSignedIn() && isSuperAdmin();
      
      match /{allChildren=**} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && (isOwner(userId) || isSuperAdmin());
      }
    }

    // Başvuru koleksiyonu
    match /applications/{appId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && isSuperAdmin();
    }

    // Kütüphane koleksiyonu
    match /library/{sectionId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isSuperAdmin();
    }

    // STK'lar
    match /ngos/{ngoId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isSuperAdmin();
    }

    // Markalar
    match /brands/{brandId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isSuperAdmin();
    }

    // Gönderiler
    match /posts/{postId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isSuperAdmin();
    }

    // Gönüllülük İlanları
    match /volunteering/{oppId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isSuperAdmin();
    }

    // Etkinlikler
    match /events/{eventId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isSuperAdmin();
    }

    // Global erişim (Süper Admin her şeyi yapabilir, diğerleri sadece okuyabilir)
    match /{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isSuperAdmin();
    }
  }
}