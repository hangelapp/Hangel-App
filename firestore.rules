
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Yardımcı Fonksiyonlar ---
    function isSignedIn() {
      return request.auth != null;
    }

    // --- Veri Erişim Kuralları ---
    // Geliştirme ve MVP aşamasında, giriş yapmış tüm kullanıcıların 
    // tüm koleksiyonlara (users, applications, ngos, brands vb.) 
    // tam erişimini sağlıyoruz. Bu, Super Admin panelindeki listeleme 
    // ve sayma hatalarını kesin olarak çözer.

    match /{allPaths=**} {
      allow read, write: if isSignedIn();
    }
    
    // Sistem watcher tetikleyici yorum satırı: Yetki kuralları global erişim için güncellendi.
  }
}
