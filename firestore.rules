
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Yardımcı Fonksiyonlar ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- Kullanıcı Verileri ---
    // Koleksiyon düzeyinde listeleme ve doküman düzeyinde okuma/yazma izinleri
    match /users {
      allow list: if isSignedIn();
      match /{userId} {
        allow get: if isSignedIn();
        allow write: if isOwner(userId);
        
        match /{allSubcollections=**} {
          allow read, write: if isOwner(userId);
        }
      }
    }

    // --- STK Profilleri ---
    match /ngos {
      allow list: if true;
      match /{ngoId} {
        allow get: if true;
        allow write: if isSignedIn();

        match /{allSubcollections=**} {
          allow read: if true;
          allow write: if isSignedIn();
        }
      }
    }

    // --- Marka Profilleri ---
    match /brands {
      allow list: if true;
      match /{brandId} {
        allow get: if true;
        allow write: if isSignedIn();
      }
    }

    // --- Zaman Tüneli Gönderileri ---
    match /posts {
      allow list: if true;
      match /{postId} {
        allow get: if true;
        allow write: if isSignedIn();
      }
    }

    // --- Gönüllülük İlanları ---
    match /volunteering {
      allow list: if true;
      match /{oppId} {
        allow get: if true;
        allow write: if isSignedIn();
      }
    }

    // --- Kütüphane İçerikleri ---
    match /library {
      allow list: if true;
      match /{sectionId} {
        allow get: if true;
        allow write: if isSignedIn();
      }
    }

    // --- Başvurular ---
    // Super Admin'in tüm başvuruları görebilmesi için koleksiyon düzeyinde izin
    match /applications {
      allow list: if isSignedIn();
      match /{appId} {
        allow read, write: if isSignedIn();
      }
    }

    // --- Etkinlikler ---
    match /events {
      allow list: if true;
      match /{eventId} {
        allow get: if true;
        allow write: if isSignedIn();
      }
    }

    // --- Acil Durum Bildirimleri ---
    match /emergencyAssistance {
      allow list: if true;
      match /{emergencyId} {
        allow get: if true;
        allow write: if isSignedIn();
      }
    }
    
    // Sistem watcher'ı tetiklemek için eklenen yorum satırı.
    // Yetkilendirme mimarisi Super Admin listeleme gereksinimlerine göre optimize edildi.
  }
}
