rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Yardımcı fonksiyonlar
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isSuperAdmin() {
      return isSignedIn() && request.auth.token.role == 'super-admin';
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // OTP kodları - sadece server-side erişim (Admin SDK)
    match /otp_codes/{docId} {
      allow read, write: if false;
    }

    // P1-1b: Dağıtık rate-limit kovaları — yalnızca Admin SDK yazar/okur
    // (server-side route'lardan `checkRateLimit()` çağrısı). Client tarafı
    // hiçbir erişim izni almaz; Admin SDK rules'ı bypass eder.
    match /rateLimits/{bucketId} {
      allow read, write: if false;
    }

    // Kullanıcı koleksiyonu
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (isOwner(userId) || isSuperAdmin());
      allow delete: if isSuperAdmin();
      
      match /{allChildren=**} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && (isOwner(userId) || isSuperAdmin());
      }
    }

    // STK'lar, Markalar, Gönderiler, Gönüllülük, Etkinlikler ve Kütüphane - Giriş yapanlar okuyabilir ve listeleyebilir
    // PDF-15: Bazı kayıtlarda adminUserId boş; kullanıcı users/{uid}.managedNgoId üzerinden
    // eşleştiriliyor. managedNgoId fallback inline pattern (storage.rules ile uyumlu).
    match /ngos/{ngoId} {
      allow read, list: if true; // Public for marketplace
      // Herkes sadece viewCount alanını artırabilir (görüntülenme sayacı)
      // VEYA: NGO admin (adminUserId match VEYA managedNgoId fallback) kendi STK'sını tam günceller
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount'])
        || (isSignedIn() && (
          resource.data.adminUserId == request.auth.uid
          || (exists(/databases/$(database)/documents/users/$(request.auth.uid))
              && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.managedNgoId == ngoId)
        ));
    }

    match /brands/{brandId} {
      allow read, list: if true; // Public read access for marketplace
      // Marka admin (adminUserId match VEYA managedBrandId fallback) kendi markasını günceller
      allow update: if isSignedIn() && (
        resource.data.adminUserId == request.auth.uid
        || (exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.managedBrandId == brandId)
      );
    }

    // Öğrenci kulüpleri (public read, super-admin global write)
    match /clubs/{clubId} {
      allow read, list: if true;
      // Owners (adminUserId match VEYA managedClubId fallback) kendi kulübünü güncelleyebilir
      allow update: if isSignedIn() && (
        resource.data.adminUserId == request.auth.uid
        || (exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.managedClubId == clubId)
      );
    }

    // Eski adlandırma — uyumluluk için (boşalsın diye)
    match /studentClubs/{clubId} {
      allow read, list: if true;
    }

    match /posts/{postId} {
      allow read, list: if true; // Public for timeline

      // Wave 6-7: posts can be authored AS an org. The top-level authorId is the
      // ORG id (ngo/brand/club doc id), NOT the publishing user's uid. The publisher
      // is a user who manages that org — either the org doc's adminUserId == uid, or
      // the user doc's managed{Ngo,Brand,Club}Id == authorId (managed*Id fallback
      // pattern, consistent with ngos/brands/clubs update rules + ngoSenders).
      function managesOrg(orgId) {
        return isSignedIn() && (
          (exists(/databases/$(database)/documents/ngos/$(orgId))
            && get(/databases/$(database)/documents/ngos/$(orgId)).data.adminUserId == request.auth.uid)
          || (exists(/databases/$(database)/documents/brands/$(orgId))
            && get(/databases/$(database)/documents/brands/$(orgId)).data.adminUserId == request.auth.uid)
          || (exists(/databases/$(database)/documents/clubs/$(orgId))
            && get(/databases/$(database)/documents/clubs/$(orgId)).data.adminUserId == request.auth.uid)
          || (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.managedNgoId == orgId
              || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.managedBrandId == orgId
              || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.managedClubId == orgId
            ))
        );
      }

      // Create: an individual posts as themselves (authorId == uid, backwards-compat)
      // OR a managing user posts on behalf of the org named in authorId. Super-admin
      // also allowed (the specific posts match overrides the global allPaths write).
      allow create: if isSuperAdmin() || (isSignedIn() && (
        request.resource.data.authorId == request.auth.uid
        || managesOrg(request.resource.data.authorId)
      ));
      // Update/delete: original author, the org's managing user, or super-admin.
      allow update, delete: if isSuperAdmin() || (isSignedIn() && (
        resource.data.authorId == request.auth.uid
        || managesOrg(resource.data.authorId)
      ));

      // PDF-7-likes-rule: per-user like subcollection (doc id = liker uid).
      // Each like is one doc owned by the liker; counts are derived via aggregate.
      // Public read so anon timeline scroll can see like counts; only the liker
      // creates/deletes their own like; updates are forbidden (no mutable fields).
      match /likes/{uid} {
        allow read, list: if true;
        allow create, delete: if isSignedIn() && request.auth.uid == uid;
        allow update: if false;
      }
    }

    match /volunteering/{oppId} {
      allow read, list: if true; // Public volunteering listings
      // NGO admins can create listings owned by their own NGO (ngoId == auth uid)
      allow create: if isSignedIn() && request.resource.data.ngoId == request.auth.uid;
      // Owners can update/delete their own listings; super-admin has full access via global rule
      allow update, delete: if isSignedIn() && resource.data.ngoId == request.auth.uid;
    }

    // Transparency: each NGO admin owns one doc with id == auth uid
    match /transparency/{userId} {
      allow read: if true; // public — used to render transparency score on NGO profile
      allow create, update, delete: if isSignedIn() && isOwner(userId);
    }

    match /events/{eventId} {
      allow read, list: if true; // Public event listings
      // Öğrenci kulüpleri kendi etkinliklerini oluşturabilir (status='Beklemede')
      allow create: if isSignedIn() &&
        request.resource.data.status == 'Beklemede' &&
        (request.resource.data.organizerId == request.auth.uid ||
         (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.managedClubId == request.resource.data.organizerId));
      // Sahibi kendi etkinliğini günceller (status DAHIL DEĞIL — super-admin onaylar).
      // Super-admin tüm alanları (status dahil) günceller; spesifik match catch-all'ı override eder.
      allow update: if isSuperAdmin() || (
        isSignedIn() && resource.data.organizerId == request.auth.uid &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status'])
      );
      allow delete: if isSuperAdmin() || (
        isSignedIn() && resource.data.organizerId == request.auth.uid
      );

      // FEAT-EVENT-RSVP — server-side write via /api/events/[id]/rsvp.
      // Client can read its own rsvp; super-admin reads all; writes go through Admin SDK.
      match /rsvps/{userId} {
        allow read: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
        allow list: if isSuperAdmin();
        allow write: if false;
      }
    }

    // FEAT-QR-CARD-ACTIVATION — kullanıcı kendi başvuru kaydını oluşturur ve görür;
    // değerlendirmeyi super-admin yapar (status alanını günceller).
    match /qrCardActivations/{actId} {
      allow read: if isSignedIn() && (request.auth.uid == resource.data.userId || isSuperAdmin());
      allow list: if isSuperAdmin();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSuperAdmin();
    }

    // Vakıf/Dernek kütük referans verisi — public-read reference data; yalnızca
    // Admin SDK yazar (scripts/import-registry.mjs, rules'ı bypass eder).
    // Kurumsal kayıt formu auth öncesi sorgulayabildiği için okuma herkese açık.
    match /registryDernekler/{id} { allow read, list: if true; allow write: if false; }
    match /registryVakiflar/{id} { allow read, list: if true; allow write: if false; }

    // Wave 6A / PDF-72: AI Asistanı promptları/ayarları.
    // /super-admin/ai-management/page.tsx setDoc(doc(db, 'aiAssistantConfig', kind), ...)
    // ile yazıyor. Secret içermez (model adı + persona prompt'u), ancak yine de
    // auth-gated tutuyoruz: yazma yalnız super-admin, okuma giriş yapan kullanıcı.
    // Global allPaths write super-admin'i zaten kapsar; explicit blok defense-in-depth.
    match /aiAssistantConfig/{kind} {
      allow read: if isSignedIn();
      allow list: if isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    // Şeffaflık endeksi kriterleri (super-admin yönetir, herkes okur)
    match /transparencyCriteria/{criterionId} {
      allow read, list: if true;
      allow create, update, delete: if isSuperAdmin();
    }

    // Kan bağışı / acil yardım talepleri (alternatif koleksiyonlar)
    match /bloodRequests/{reqId} {
      allow read, list: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.requestedBy == request.auth.uid;
      allow update, delete: if isSuperAdmin();
    }

    match /userRequests/{reqId} {
      allow read, list: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSuperAdmin();
    }

    match /library/{sectionId} {
      allow read, list: if true; // Public library content
    }

    // Sözleşmeler ve politikalar (super-admin yönetir, herkes okur)
    match /contracts/{contractId} {
      allow read, list: if true;
      allow create, update, delete: if isSuperAdmin();
    }

    // Hibe programları ve fonlar (super-admin yönetir, herkes okur)
    match /funds/{fundId} {
      allow read, list: if true;
      allow create, update, delete: if isSuperAdmin();
    }

    // PDF-17: Hibe başvuruları. NGO admin başvuru oluşturur, kendi başvurularını okur;
    // super-admin tüm başvuruları görür ve karar verir (status alanını günceller).
    // Veri şeması (src/app/ngo-admin/funds/page.tsx#handleApply):
    //   { fundId, fundName, applicantId, applicantNgoId, status, createdAt, message }
    match /fundApplications/{appId} {
      allow read: if isSignedIn() && (
        resource.data.applicantId == request.auth.uid
        || isSuperAdmin()
        || (resource.data.applicantNgoId is string
            && exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.managedNgoId == resource.data.applicantNgoId)
      );
      // List sadece super-admin için açık (NGO scope per-applicant queries client tarafında applicantId == auth.uid ile filtrelenir).
      allow list: if isSuperAdmin() || (
        isSignedIn() && request.query.limit <= 100
      );
      // Create: kullanıcı kendi adına başvurur, applicantId kendi UID'i olmalı.
      allow create: if isSignedIn()
        && request.resource.data.applicantId == request.auth.uid
        && request.resource.data.keys().hasAll(['applicantId', 'fundId', 'status', 'createdAt'])
        && request.resource.data.status == 'Beklemede';
      // Update: başvuru sahibi sadece kendi 'Beklemede'/'draft' başvurusunu düzenleyebilir;
      // status değişimi super-admin yetkisidir.
      allow update: if isSuperAdmin() || (
        isSignedIn()
        && resource.data.applicantId == request.auth.uid
        && resource.data.status in ['Beklemede', 'draft']
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'applicantId', 'fundId', 'createdAt'])
      );
      allow delete: if isSuperAdmin();
    }

    // Site ayarları (anasayfa/about/dernek içerikleri — super-admin yönetir, herkes okur)
    match /siteSettings/{docId} {
      allow read, list: if true;
      allow create, update, delete: if isSuperAdmin();
    }

    // Anket cevapları (kullanıcı kendi cevabını yazar; super-admin hepsini görür)
    match /surveys/{surveyId} {
      allow list, read: if isSuperAdmin();
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSuperAdmin();
    }

    // Uygulama değerlendirmeleri / yıldızlar (kullanıcı kendi rating'ini yazar; super-admin hepsini görür)
    match /ratings/{ratingId} {
      allow list, read: if isSuperAdmin();
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSuperAdmin();
    }

    // Bağışlar (kullanıcı kendi alışverişini yazar, kendi bağışlarını okur, super-admin tümünü yönetir)
    match /donations/{donationId} {
      allow list: if isSuperAdmin() || isSignedIn();
      allow read: if isSignedIn() && (
        resource == null ||
        resource.data.userId == request.auth.uid ||
        isSuperAdmin()
      );
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid;
      // Super-admin tüm alanları günceller (status, amounts, payoutDate vb.)
      // Kullanıcı sadece kendi okuma durumunu (read) günceller
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // Destek talepleri (kullanıcı oluşturur ve okur, super-admin tüm talepleri yönetir)
    match /supportTickets/{ticketId} {
      allow list: if isSuperAdmin() || isSignedIn();
      allow read: if isSignedIn() && (
        resource == null ||
        resource.data.userId == request.auth.uid ||
        isSuperAdmin()
      );
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'open';
      // Kullanıcı kendi talebini günceller (sadece message/subject); super-admin her şeyi günceller
      allow update: if isSuperAdmin() || (
        isSignedIn() && resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['subject', 'message', 'updatedAt'])
      );
      allow delete: if isSuperAdmin();
    }

    // Esnek site sayfaları (basın, etkinlik, duyuru — super-admin yönetir, herkes okur)
    match /sitePages/{pageId} {
      allow read, list: if true;
      allow create, update, delete: if isSuperAdmin();
    }

    // Acil durum talepleri
    //  - Kullanıcılar: 'pending' status ile kendi taleplerini oluşturabilir
    //  - Süper Admin: tüm CRUD (onay → 'sent' broadcasts notifications)
    match /emergencyRequests/{reqId} {
      allow read, list: if isSignedIn();
      allow create: if isSuperAdmin() || (
        isSignedIn() &&
        request.resource.data.status == 'pending' &&
        request.resource.data.requestedBy == request.auth.uid
      );
      allow update, delete: if isSuperAdmin();
    }

    // Acil durum yanıtları (kullanıcılar kendi yanıtını oluşturur, süper admin hepsini görür)
    match /emergencyResponses/{respId} {
      allow list: if isSuperAdmin() || isSignedIn();
      allow read: if isSignedIn() && (
        resource == null ||
        resource.data.userId == request.auth.uid ||
        isSuperAdmin()
      );
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status in ['positive', 'negative'];
      allow update, delete: if isSuperAdmin() || (
        isSignedIn() && resource.data.userId == request.auth.uid
      );
    }

    // Bildirimler (Süper Admin + NGO admin davetleri yazar; alıcı okur ve okundu işaretler)
    match /notifications/{notifId} {
      allow list: if isSignedIn();
      allow read: if isSignedIn() && (
        resource == null ||
        resource.data.userId == request.auth.uid ||
        isSuperAdmin()
      );
      // Süper admin her şeyi yazabilir; ayrıca imzalı kullanıcılar:
      //  - 'invitation' tipi (NGO admin → davet ettiği üyeye)
      //  - 'donation' tipi (alışveriş sonrası kendi bildirimi)
      allow create: if isSuperAdmin() || (
        isSignedIn() &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.type in ['invitation', 'donation']
      );
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']);
      allow delete: if isSuperAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // Toplu duyuru parent docs — per-message analytics (gönderildi/okundu özeti).
    // Yalnızca süper admin: oluşturur, okur ve siler.
    match /broadcasts/{broadcastId} {
      allow read, list, create, update, delete: if isSuperAdmin();
    }

    // ----- Toplu SMS & E-Posta sistemi -----

    // Şablonlar (super-admin yönetir; client okur)
    match /messageTemplates/{tplId} {
      allow list, read: if isSuperAdmin();
    }

    // Segmentler (super-admin yönetir)
    match /recipientSegments/{segId} {
      allow list, read: if isSuperAdmin();
    }

    // Kampanyalar + alıcı subcollection (super-admin yönetir)
    match /campaigns/{campaignId} {
      allow list, read: if isSuperAdmin();
      match /recipients/{rid} {
        allow list, read: if isSuperAdmin();
      }
    }

    // Provider konfigleri (super-admin yönetir; secret'lar env'de)
    match /messagingProviders/{key} {
      allow list, read: if isSuperAdmin();
    }

    // CSV upload kayıtları (super-admin yönetir)
    match /csvUploads/{id} {
      allow list, read: if isSuperAdmin();
    }

    // WhatsApp template'leri (super-admin yönetir; Meta'dan senkronlanır)
    match /whatsappTemplates/{id} {
      allow list, read: if isSuperAdmin();
    }

    // Pricing config (super-admin yönetir; herkes okur — fiyat şeffaflığı)
    match /messagingPricing/{id} {
      allow read: if isSignedIn();
    }

    // Kontör paketleri (herkes okuyabilir; super-admin yönetir)
    match /messagingPackages/{id} {
      allow list, read: if isSignedIn();
    }

    // NGO cüzdanları — server-only (Admin SDK üzerinden); NGO admin kendi cüzdanını okur
    match /ngoMessagingWallets/{ngoId} {
      allow read: if isSignedIn() && (
        isSuperAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.managedNgoId == ngoId)
      );
      allow write: if false;
    }

    // Transactions — server-only; NGO admin kendi NGO'sunun transactions'ını okuyabilir
    match /messagingTransactions/{id} {
      allow list, read: if isSignedIn() && (
        isSuperAdmin() ||
        (resource != null &&
         exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.managedNgoId == resource.data.ngoId)
      );
      allow write: if false;
    }

    // NGO sender'ları — NGO admin kendi sender'larını okur; sadece super-admin onaylar
    match /ngoSenders/{ngoId}/senders/{senderId} {
      allow read, list: if isSignedIn() && (
        isSuperAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.managedNgoId == ngoId)
      );
      // Create: NGO admin pending olarak talep yaratabilir
      allow create: if isSignedIn() &&
        request.resource.data.status == 'pending' &&
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.managedNgoId == ngoId);
      // Update/delete sadece super-admin (global rule kapsar)
    }

    // NGO message templates — NGO admin kendi şablonlarını yönetir
    match /ngoMessageTemplates/{id} {
      allow read, list: if isSignedIn() && (
        isSuperAdmin() ||
        (resource != null &&
         exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.managedNgoId == resource.data.ngoId)
      );
      allow create: if isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.managedNgoId == request.resource.data.ngoId;
      allow update, delete: if isSignedIn() && (
        isSuperAdmin() ||
        (resource != null &&
         exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.managedNgoId == resource.data.ngoId)
      );
    }

    // Payment orders — server-only; NGO admin kendi NGO'sunun order'larını okur
    match /paymentOrders/{id} {
      allow read, list: if isSignedIn() && (
        isSuperAdmin() ||
        (resource != null &&
         exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.managedNgoId == resource.data.ngoId)
      );
      allow write: if false;
    }

    // Invoices — NGO admin kendi NGO'sunun faturalarını okur
    match /messagingInvoices/{id} {
      allow read, list: if isSignedIn() && (
        isSuperAdmin() ||
        (resource != null &&
         exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.managedNgoId == resource.data.ngoId)
      );
      allow write: if false;
    }

    // NGO recipient segments — NGO admin kendi segmentlerini yönetir
    match /ngoRecipientSegments/{id} {
      allow read, list: if isSignedIn() && (
        isSuperAdmin() ||
        (resource != null &&
         exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.managedNgoId == resource.data.ngoId)
      );
      allow create: if isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.managedNgoId == request.resource.data.ngoId;
      allow update, delete: if isSignedIn() && (
        isSuperAdmin() ||
        (resource != null &&
         exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.managedNgoId == resource.data.ngoId)
      );
    }

    // Server-only: gerçek mesaj kuyruğu — Admin SDK ile yazılır/okunur
    match /messageJobs/{id} {
      allow read, write: if false;
    }

    // Server-only: provider webhook event landing
    match /deliveryEvents/{id} {
      allow read, write: if false;
    }

    // Server-only: append-only audit log
    match /messagingAuditLogs/{id} {
      allow list, read: if isSuperAdmin();
      allow create, update, delete: if false;
    }

    // Server-only: rate limit state
    match /messagingRateState/{driver} {
      allow read, write: if false;
    }

    // Server-only: mock provider dev outbox (yalnızca local/dev)
    match /_devOutbox/{id} {
      allow read, write: if false;
    }

    // FEAT-AFFILIATE-WEBHOOK: brand-signed affiliate sale confirmations
    // (Admin SDK only — written by /api/affiliate/webhook/[brandId] after
    //  HMAC SHA256 verification). Doc id is `{brandId}__{orderId}` for
    //  create-or-fail idempotency. No client read/write.
    match /affiliateConfirmations/{confId} {
      allow read, write: if false;
    }

    // KVKK pazarlama izni: sahibi sadece kendi toggle'larını günceller; unsubscribeToken server-only
    match /userMarketingConsent/{userId} {
      allow read: if isSignedIn() && (isOwner(userId) || isSuperAdmin());
      // İlk kez opt-in için create — sadece sahibi, sadece enabled flag'leri ile
      allow create: if isSignedIn() && isOwner(userId) &&
        !('unsubscribeToken' in request.resource.data) &&
        !('iys' in request.resource.data);
      // Update — sahibi sadece email.enabled / sms.enabled / channelAddresses alanlarını değiştirebilir
      allow update: if isSignedIn() && isOwner(userId) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['email', 'sms', 'channelAddresses', 'updatedAt']);
      allow delete: if isSuperAdmin();
    }

    // Yetkili davetiyeleri (NGO admin → mevcut üyeye rol daveti)
    match /userInvitations/{inviteId} {
      allow list: if isSignedIn();
      allow read: if isSignedIn() && (
        resource == null ||
        resource.data.invitedBy == request.auth.uid ||
        resource.data.inviteeUserId == request.auth.uid ||
        isSuperAdmin()
      );
      // İki yol: (a) normal davet (status='pending', invitedBy=request.auth.uid)
      //          (b) super-admin direkt yetkilendirme (status='accepted', invitedBy='super-admin')
      // Her iki yolda da invitee mevcut bir user dokümanı olmalı.
      allow create: if isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.resource.data.inviteeUserId)) &&
        (
          (request.resource.data.invitedBy == request.auth.uid &&
           request.resource.data.status == 'pending')
          ||
          (isSuperAdmin() && request.resource.data.status == 'accepted')
        );
      // Sadece davet alan veya davet eden güncelleyebilir/silebilir
      allow update, delete: if isSignedIn() && (
        resource.data.invitedBy == request.auth.uid ||
        resource.data.inviteeUserId == request.auth.uid ||
        isSuperAdmin()
      );
    }

    // Başvuru koleksiyonu
    match /applications/{appId} {
      allow list: if isSignedIn();
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || isSuperAdmin());
      // Corporate registrations (BRAND/CLUB/NGO) can be submitted by anonymous users
      // (onboarding flow runs before account creation). All other app types require auth.
      allow create: if isSignedIn() || (
        request.resource.data.entityType in ['BRAND', 'CLUB', 'NGO'] &&
        request.resource.data.status == 'Beklemede' &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.email is string &&
        request.resource.data.email.size() > 0
      );
      allow update, delete: if isSuperAdmin();
    }

    // FEAT-ENTITY-INBOX: Birebir mesajlar (kullanıcı ↔ kullanıcı / STK / marka / kulüp / yönetici)
    // Veri şeması (src/app/messages/page.tsx):
    //   { sender:{id,name,avatarUrl}, senderId, recipient:{id,name,avatarUrl},
    //     recipientId, subject, content, timestamp, status, readBy:{[uid]:ts} }
    // recipientId bir KULLANICI uid'i ya da bir ENTITY doc id'si (ngo/brand/club) olabilir.
    // Entity'ye gelen mesajları o entity'yi yöneten admin okur (managed*Id fallback pattern —
    // ngoSenders / fundApplications ile uyumlu). Yanıt yazarken senderId == auth.uid kalır
    // (entity yalnızca sender.name/sender.id ile GÖRSEL olarak temsil edilir) → create rule
    // gevşetilmeden entity adına yanıt mümkün.
    match /messages/{messageId} {
      // recipientId, istek sahibinin yönettiği bir entity'ye mi işaret ediyor?
      function recipientIsMyManagedEntity() {
        return exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.managedNgoId == resource.data.recipientId
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.managedBrandId == resource.data.recipientId
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.managedClubId == resource.data.recipientId
        );
      }

      // Wave 6-7 create-hardening helpers. Normal kullanıcı yalnızca bir kuruma
      // (STK/marka/kulüp) ya da bir admin/super-admin kullanıcıya mesaj atabilir;
      // kullanıcı→kullanıcı DM kapalı.
      // recipientId bir entity (ngo/brand/club) doc id'si mi?
      function recipientIsEntity(rid) {
        return exists(/databases/$(database)/documents/ngos/$(rid))
          || exists(/databases/$(database)/documents/brands/$(rid))
          || exists(/databases/$(database)/documents/clubs/$(rid));
      }
      // recipientId bir admin/super-admin kullanıcı mı? (kurum yöneticileri dahil)
      function recipientIsAdminUser(rid) {
        return exists(/databases/$(database)/documents/users/$(rid))
          && get(/databases/$(database)/documents/users/$(rid)).data.role
             in ['super-admin', 'ngo-admin', 'brand-admin', 'club-admin', 'admin'];
      }
      // İstek sahibi bir entity-admin mi? (mevcut thread'lerin korunması: entity-admin
      // bir normal kullanıcıya YANIT verebilmeli — alıcı normal kullanıcı olsa bile.)
      function senderIsEntityAdmin() {
        return exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
              in ['super-admin', 'ngo-admin', 'brand-admin', 'club-admin', 'admin']
            || ('managedNgoId' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data)
            || ('managedBrandId' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data)
            || ('managedClubId' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data)
          );
      }

      // Tekil okuma: alıcı, gönderen, entity-admin veya super-admin.
      allow read: if isSignedIn() && (
        resource == null ||
        resource.data.recipientId == request.auth.uid ||
        resource.data.senderId == request.auth.uid ||
        isSuperAdmin() ||
        recipientIsMyManagedEntity()
      );

      // Liste: imzalı kullanıcı (per-doc gizlilik `read` ile garanti edilir; istemci
      // sorguları `recipientId == auth.uid` veya `recipientId == <yönetilen entity>` ile
      // filtrelenir). notifications pattern — query.limit'e bağımlı değil, çünkü mevcut
      // kullanıcı gelen kutusu sorgusu limit'siz çalışır.
      allow list: if isSignedIn();

      // Oluşturma: senderId mutlaka istek sahibinin uid'i olmalı (spoof engeli) VE
      // alıcı bir kurum (STK/marka/kulüp) ya da bir admin/super-admin kullanıcı olmalı —
      // normal kullanıcı→normal kullanıcı DM kapalı. Entity-admin, normal kullanıcıya
      // YANIT verebilir (senderIsEntityAdmin) → mevcut thread'ler korunur.
      // Entity adına yanıt: senderId = admin uid, sender.name = entity adı.
      allow create: if isSignedIn()
        && request.resource.data.senderId == request.auth.uid
        && (
          recipientIsEntity(request.resource.data.recipientId)
          || recipientIsAdminUser(request.resource.data.recipientId)
          || senderIsEntityAdmin()
          || isSuperAdmin()
        );

      // Güncelleme: yalnızca okundu bilgisi (`readBy`) eklenebilir; alıcı, entity-admin
      // veya super-admin yapabilir. Başka alanlar değiştirilemez.
      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy'])
        && (
          resource.data.recipientId == request.auth.uid ||
          isSuperAdmin() ||
          recipientIsMyManagedEntity()
        );

      // Silme: super-admin (global allPaths kapsar) — explicit deny diğer herkese.
      allow delete: if isSuperAdmin();
    }

    // Global Yazma Erişimi (Sadece Super Admin)
    match /{allPaths=**} {
      allow write: if isSuperAdmin();
    }
  }
}