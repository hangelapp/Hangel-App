
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Yardımcı Fonksiyonlar ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- Veri Erişim Kuralları ---
    // Geliştirme aşamasında tüm koleksiyonlar için giriş yapmış kullanıcılara tam yetki veriyoruz.
    // Bu, Super Admin panelindeki sayaçların ve listelerin hatasız çalışmasını sağlar.

    match /users/{userId} {
      allow read, write: if isSignedIn();
      
      match /{allSubcollections=**} {
        allow read, write: if isSignedIn();
      }
    }

    match /ngos/{ngoId} {
      allow read, write: if isSignedIn();

      match /{allSubcollections=**} {
        allow read, write: if isSignedIn();
      }
    }

    match /brands/{brandId} {
      allow read, write: if isSignedIn();
    }

    match /posts/{postId} {
      allow read, write: if isSignedIn();
    }

    match /volunteering/{oppId} {
      allow read, write: if isSignedIn();
    }

    match /library/{sectionId} {
      allow read, write: if isSignedIn();
    }

    match /applications/{appId} {
      allow read, write: if isSignedIn();
    }

    match /events/{eventId} {
      allow read, write: if isSignedIn();
    }

    match /emergencyAssistance/{emergencyId} {
      allow read, write: if isSignedIn();
    }
    
    // Sistem watcher tetikleyici yorum satırı: Yetki kuralları Super Admin erişimi için güncellendi.
  }
}
