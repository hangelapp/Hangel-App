rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Yardımcı Fonksiyonlar ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- Kullanıcı Verileri ---
    match /users/{userId} {
      // Bireysel döküman erişimi sahibine özel
      allow get, create, update, delete: if isOwner(userId);
      
      // Dashboard istatistikleri için listelemeye (count vb.) izin veriyoruz
      allow list: if isSignedIn();

      // Alt koleksiyonlar (badges, certificates, qrCodePayments vb.)
      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // --- STK Profilleri (Herkese Açık Okuma) ---
    match /ngos/{ngoId} {
      allow get, list: if true;
      allow write: if isSignedIn(); // Prototip aşamasında tüm giriş yapmış kullanıcılara izin veriyoruz

      match /{allSubcollections=**} {
        allow read: if true;
        allow write: if isSignedIn();
      }
    }

    // --- Marka Profilleri (Herkese Açık Okuma) ---
    match /brands/{brandId} {
      allow get, list: if true;
      allow write: if isSignedIn();
    }

    // --- Zaman Tüneli Gönderileri ---
    match /posts/{postId} {
      allow get, list: if true;
      allow create, update, delete: if isSignedIn();
    }

    // --- Gönüllülük İlanları ---
    match /volunteering/{oppId} {
      allow get, list: if true;
      allow write: if isSignedIn();
    }

    // --- Kütüphane İçerikleri ---
    match /library/{sectionId} {
      allow get, list: if true;
      allow write: if isSignedIn();
    }

    // --- Başvurular ---
    match /applications/{appId} {
      allow get, list, create, update, delete: if isSignedIn();
    }

    // --- Etkinlikler ---
    match /events/{eventId} {
      allow get, list: if true;
      allow create, update, delete: if isSignedIn();
    }

    // --- Acil Durum Bildirimleri ---
    match /emergencyAssistance/{emergencyAssistanceId} {
      allow get, list: if true;
      allow create, update, delete: if isSignedIn();
    }
  }
}
