rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Super admin: tüm Storage'a yazma yetkisi.
    // NOT: Cross-service Firestore lookup KULLANMIYORUZ — IAM provisioning gerekmez.
    // Sadece email allowlist + Firebase Auth custom claims (role: 'super-admin').
    function isSuperAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'ismailhilmi@hangel.org' ||
        request.auth.token.role == 'super-admin'
      );
    }

    // Kullanıcı profil/profil fotoğrafları
    match /users/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if (request.auth != null && request.auth.uid == userId) || isSuperAdmin();
    }

    // STK şeffaflık belgeleri
    // P1-4 (KVKK): public read kaldırıldı — finansal raporlar / üye listeleri PII içeriyor.
    // Okuma: belge sahibi (NGO uid), NGO admin'i (managedNgoId), veya super-admin.
    // Yazma: aynı.
    match /transparency/{userId}/{allPaths=**} {
      allow read: if isSuperAdmin() ||
        (request.auth != null && request.auth.uid == userId) ||
        isManagedEntity('Ngo', userId);
      allow write: if isSuperAdmin() ||
        (request.auth != null && request.auth.uid == userId) ||
        isManagedEntity('Ngo', userId);
    }

    // STK/Marka/Kulüp logoları ve kapak fotoğrafları
    // adminUserId == auth.uid pattern'inde yönetilen entity için Firestore lookup ile yazma
    function isManagedEntity(kind, entityId) {
      return request.auth != null && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data['managed' + kind + 'Id'] == entityId;
    }

    match /ngos/{ngoId}/{allPaths=**} {
      allow read: if true;
      allow write: if isSuperAdmin() ||
        (request.auth != null && request.auth.uid == ngoId) ||
        isManagedEntity('Ngo', ngoId);
    }

    match /brands/{brandId}/{allPaths=**} {
      allow read: if true;
      allow write: if isSuperAdmin() ||
        (request.auth != null && request.auth.uid == brandId) ||
        isManagedEntity('Brand', brandId);
    }

    match /studentClubs/{clubId}/{allPaths=**} {
      allow read: if true;
      allow write: if isSuperAdmin() ||
        (request.auth != null && request.auth.uid == clubId) ||
        isManagedEntity('Club', clubId);
    }

    match /clubs/{clubId}/{allPaths=**} {
      allow read: if true;
      allow write: if isSuperAdmin() ||
        (request.auth != null && request.auth.uid == clubId) ||
        isManagedEntity('Club', clubId);
    }

    // Post görselleri (uzun vadede Base64 yerine Storage)
    match /posts/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId || isSuperAdmin();
    }

    // Varsayılan: kimliği doğrulanmış kullanıcı okuyabilir, sadece super-admin yazabilir
    match /{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if isSuperAdmin();
    }
  }
}
