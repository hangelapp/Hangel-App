    "logs": "firebase functions:log"
  },
  "dependencies": {
    "@parse/node-apn": "^8.1.0",
    "@sendgrid/mail": "^8.1.3",
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^5.0.0",
    "twilio": "^5.3.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0"
  },
  "private": true
}
