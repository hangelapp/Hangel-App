{
  "name": "hangel-functions",
  "version": "1.0.0",
  "description": "hangel Cloud Functions (Firestore triggers, scheduled jobs).",
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "scripts": {
