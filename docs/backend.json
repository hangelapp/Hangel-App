
{
  "entities": {
    "User": {
      "title": "User",
      "type": "object",
      "description": "Kullanıcı profili ve gönüllülük verileri.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "username": { "type": "string" },
        "avatarUrl": { "type": "string" },
        "impactScore": { "type": "number" },
        "personalInfo": { "type": "object" },
        "volunteerInfo": { "type": "object" },
        "stats": { "type": "object" }
      }
    },
    "NGO": {
      "title": "NGO",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "type": { "type": "string" },
        "transparencyScore": { "type": "number" },
        "stats": { "type": "object" },
        "about": { "type": "string" },
        "avatarUrl": { "type": "string" },
        "coverPhotoUrl": { "type": "string" }
      }
    },
    "Brand": {
      "title": "Brand",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "donationRate": { "type": "number" },
        "category": { "type": "string" },
        "type": { "type": "string" },
        "logoUrl": { "type": "string" }
      }
    },
    "Post": {
      "title": "Post",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "author": { "type": "object" },
        "content": { "type": "string" },
        "timestamp": { "type": "string" },
        "likes": { "type": "number" },
        "imageUrl": { "type": "string" },
        "sponsored": { "type": "boolean" }
      }
    },
    "Volunteering": {
      "title": "Volunteering",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "organization": { "type": "string" },
        "points": { "type": "number" },
        "location": { "type": "object" },
        "description": { "type": "string" },
        "socialArea": { "type": "string" }
      }
    },
    "LibrarySection": {
      "title": "LibrarySection",
      "type": "object",
      "properties": {
        "slug": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "icon": { "type": "string" },
        "items": { "type": "array" }
      }
    },
    "Application": {
      "title": "Application",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string" },
        "status": { "type": "string" },
        "date": { "type": "string" }
      }
    },
    "Event": {
      "title": "Event",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "organizer": { "type": "string" },
        "startDate": { "type": "string" },
        "location": { "type": "object" }
      }
    }
  },
  "auth": {
    "providers": ["password", "phone"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/backend/entities/User" },
      "description": "Kullanıcı profilleri."
    },
    "/ngos/{ngoId}": {
      "schema": { "$ref": "#/backend/entities/NGO" },
      "description": "STK dökümanları."
    },
    "/brands/{brandId}": {
      "schema": { "$ref": "#/backend/entities/Brand" },
      "description": "Marka dökümanları."
    },
    "/posts/{postId}": {
      "schema": { "$ref": "#/backend/entities/Post" },
      "description": "Zaman tüneli gönderileri."
    },
    "/volunteering/{oppId}": {
      "schema": { "$ref": "#/backend/entities/Volunteering" },
      "description": "Gönüllülük ilanları."
    },
    "/library/{sectionId}": {
      "schema": { "$ref": "#/backend/entities/LibrarySection" },
      "description": "Kütüphane içerikleri."
    },
    "/applications/{appId}": {
      "schema": { "$ref": "#/backend/entities/Application" },
      "description": "STK, Marka ve Kulüp başvuruları."
    },
    "/events/{eventId}": {
      "schema": { "$ref": "#/backend/entities/Event" },
      "description": "Etkinlik dökümanları."
    }
  }
}
