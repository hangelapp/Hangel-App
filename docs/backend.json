{
  "entities": {
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Kullanıcı profili, kişisel ve gönüllülük verilerini içerir.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "username": { "type": "string" },
        "avatarUrl": { "type": "string", "format": "uri" },
        "personalInfo": {
          "type": "object",
          "properties": {
            "email": { "type": "string", "format": "email" },
            "phone": { "type": "string" },
            "bloodType": { "type": "string" },
            "address": {
              "type": "object",
              "properties": {
                "city": { "type": "string" },
                "district": { "type": "string" },
                "fullAddress": { "type": "string" }
              }
            }
          }
        },
        "volunteerInfo": {
          "type": "object",
          "properties": {
            "skills": { "type": "array", "items": { "type": "string" } },
            "interests": { "type": "array", "items": { "type": "string" } },
            "education": { "type": "array", "items": { "type": "object" } }
          }
        },
        "impactScore": { "type": "number", "default": 0 }
      }
    },
    "Badge": {
      "title": "Badge",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "level": { "type": "string" },
        "earnedAt": { "type": "string", "format": "date-time" }
      }
    },
    "Certificate": {
      "title": "Certificate",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "organization": { "type": "string" },
        "date": { "type": "string" }
      }
    }
  },
  "auth": {
    "providers": ["password", "phone"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "User",
          "schema": { "$ref": "#/backend/entities/User" },
          "description": "Ana kullanıcı dokümanı."
        }
      },
      {
        "path": "/users/{userId}/badges/{badgeId}",
        "definition": {
          "entityName": "Badge",
          "schema": { "$ref": "#/backend/entities/Badge" },
          "description": "Kullanıcının kazandığı rozetler."
        }
      },
      {
        "path": "/users/{userId}/certificates/{certId}",
        "definition": {
          "entityName": "Certificate",
          "schema": { "$ref": "#/backend/entities/Certificate" },
          "description": "Kullanıcının kazandığı sertifikalar."
        }
      }
    ]
  }
}
