# ---- Firebase Web SDK (client-side, NEXT_PUBLIC_*) ----
# Firebase Console → Project Settings → Your apps → Web App
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=

# Base URL of the deployed app (used in emails, unsubscribe links, etc.)
NEXT_PUBLIC_APP_URL=https://hangel.org
APP_URL=https://hangel.org

# ---- Firebase Admin SDK (server-side) ----
# Place the service account JSON at .firebase-service-account.json (gitignored)
# OR configure via GOOGLE_APPLICATION_CREDENTIALS to a different path.

# ---- AI ----
# Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ---- Admin import (one-time data seeding) ----
ADMIN_IMPORT_KEY=

# ---- Messaging system ----
# Internal worker auth (Cloud Scheduler, cron jobs)
MESSAGING_WORKER_KEY=
# Webhook payload signature secret
MESSAGING_WEBHOOK_SECRET=

# Drivers — set to 'mock' for local dev, real provider name in prod
# Email: 'mock' | 'resend' | 'smtp'
EMAIL_DRIVER=mock
# SMS: 'mock' | 'netgsm' | 'iletimerkezi'
SMS_DRIVER=mock

# From-address defaults
DEFAULT_FROM_EMAIL=noreply@hangel.org
DEFAULT_FROM_NAME=Hangel

# Cost tracking (TRY per unit)
EMAIL_COST_TRY_PER_MESSAGE=0.10
SMS_COST_TRY_PER_SEGMENT=0.30

# SMS opt-out reply keyword
SMS_OPTOUT_KEYWORD=RED

# ---- Resend (email provider, used when EMAIL_DRIVER=resend) ----
# https://resend.com/api-keys
RESEND_API_KEY=

# ---- Netgsm (SMS provider, used when SMS_DRIVER=netgsm) ----
NETGSM_USERNAME=
NETGSM_PASSWORD=
NETGSM_APP_KEY=
NETGSM_HEADER=
NETGSM_IYS_FILTER=

# P0-2: comma-separated hosts allowed by /api/proxy
# NOTE: /api/proxy was deleted (2026-05-18) due to zero callers + open SSRF risk.
# If reintroduced, list explicit hostnames here (e.g. api.example.com,api2.example.com).
ALLOWED_PROXY_HOSTS=

# ---- P1-2: Webhook HMAC + replay protection (2026-05-18) ----
# Resend webhook (Svix v1 HMAC). Resend Dashboard → Webhooks → Signing Secret.
# Format: whsec_<base64>. RESEND_API_KEY ile karıştırma.
RESEND_WEBHOOK_SECRET=
# Netgsm webhook'unda HMAC yok — geçici olarak IP whitelist (comma-separated, exact match).
# TODO(P1-2b): Netgsm gerçek imza sağladığında bunu kaldır ve NETGSM_WEBHOOK_SECRET ekle.
NETGSM_WEBHOOK_ALLOWED_IPS=

# ---- P3-5: Missing env vars audited from src/ (2026-05-18) ----

# WhatsApp (Meta Cloud API driver, used when WHATSAPP_DRIVER=meta-cloud)
# Driver selector: 'mock' | 'meta-cloud'
WHATSAPP_DRIVER=mock
# Meta App Secret — signs webhook payloads (X-Hub-Signature-256)
META_APP_SECRET=
# Permanent / system-user access token for Cloud API calls
META_WA_ACCESS_TOKEN=
# WhatsApp Business Account ID (used by template sync)
META_WA_BUSINESS_ACCOUNT_ID=
# Webhook verify token configured in Meta App dashboard (GET hub.verify_token check)
META_WA_VERIFY_TOKEN=
# Phone Number ID for the WABA sender (client-visible, used in send URL)
NEXT_PUBLIC_WABA_PHONE_ID=

# N-Kolay payment (used when PAYMENT_DRIVER=nkolay)
# Driver selector: 'mock' | 'nkolay'
PAYMENT_DRIVER=mock
# N-Kolay merchant API key
NKOLAY_API_KEY=
# N-Kolay API base URL (e.g. https://api.nkolay.com)
NKOLAY_API_URL=
# N-Kolay HMAC secret for signing requests
NKOLAY_SECRET_KEY=
# N-Kolay sx parameter (merchant-specific)
NKOLAY_SX=
