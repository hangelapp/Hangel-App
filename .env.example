# ---- Firebase Web SDK (client-side, NEXT_PUBLIC_*) ----
# Firebase Console → Project Settings → Your apps → Web App
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
# Firebase Cloud Messaging VAPID public key (Project Settings → Cloud Messaging
# → Web configuration → "Web push certificates"). Required for FCM web push
# token registration (FEAT-FCM-PUSH-NOTIF). If unset, registration is skipped
# with a console warning — no errors thrown.
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Base URL of the deployed app (used in emails, unsubscribe links, etc.)
NEXT_PUBLIC_APP_URL=https://hangel.org
APP_URL=https://hangel.org

# ---- Firebase Admin SDK (server-side) ----
# Place the service account JSON at .firebase-service-account.json (gitignored)
# OR configure via GOOGLE_APPLICATION_CREDENTIALS to a different path.

# ---- AI ----
# Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ---- Admin import (one-time data seeding) ----
ADMIN_IMPORT_KEY=

# ---- Messaging system ----
# Internal worker auth (Cloud Scheduler, cron jobs)
MESSAGING_WORKER_KEY=
# Webhook payload signature secret
MESSAGING_WEBHOOK_SECRET=

# Drivers — set to 'mock' for local dev, real provider name in prod
# Email: 'mock' | 'resend' | 'smtp'
EMAIL_DRIVER=mock
# SMS: 'mock' | 'netgsm' | 'iletimerkezi'
SMS_DRIVER=mock

# From-address defaults
DEFAULT_FROM_EMAIL=noreply@hangel.org
DEFAULT_FROM_NAME=Hangel

# Cost tracking (TRY per unit)
EMAIL_COST_TRY_PER_MESSAGE=0.10
SMS_COST_TRY_PER_SEGMENT=0.30

# SMS opt-out reply keyword
SMS_OPTOUT_KEYWORD=RED

# ---- SMTP (email provider, used when EMAIL_DRIVER=smtp) ----
# Google Workspace example:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587            (STARTTLS) — alternatif: 465 (SSL)
#   SMTP_USER=noreply@hangel.org
#   SMTP_PASSWORD=<App Password — Google hesabında 2FA aktif olmalı>
# App Password üretmek: https://myaccount.google.com/apppasswords
# Limit: Google Workspace 2000 mail/gün, kişisel Gmail 500/gün.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
# SMTP_SECURE opsiyonel (default: port 465 = true, diğerleri false STARTTLS).
SMTP_SECURE=

# ---- Resend (email provider, used when EMAIL_DRIVER=resend) ----
# https://resend.com/api-keys
RESEND_API_KEY=

# ---- Netgsm (SMS provider, used when SMS_DRIVER=netgsm) ----
NETGSM_USERNAME=
NETGSM_PASSWORD=
NETGSM_APP_KEY=
NETGSM_HEADER=
NETGSM_IYS_FILTER=

# P0-2: comma-separated hosts allowed by /api/proxy
# NOTE: /api/proxy was deleted (2026-05-18) due to zero callers + open SSRF risk.
# If reintroduced, list explicit hostnames here (e.g. api.example.com,api2.example.com).
ALLOWED_PROXY_HOSTS=

# ---- P1-2: Webhook HMAC + replay protection (2026-05-18) ----
# Resend webhook (Svix v1 HMAC). Resend Dashboard → Webhooks → Signing Secret.
# Format: whsec_<base64>. RESEND_API_KEY ile karıştırma.
RESEND_WEBHOOK_SECRET=
# Netgsm webhook'unda HMAC yok — geçici olarak IP whitelist (comma-separated, exact match).
# TODO(P1-2b): Netgsm gerçek imza sağladığında bunu kaldır ve NETGSM_WEBHOOK_SECRET ekle.
NETGSM_WEBHOOK_ALLOWED_IPS=

# ---- P3-5: Missing env vars audited from src/ (2026-05-18) ----

# WhatsApp (Meta Cloud API driver, used when WHATSAPP_DRIVER=meta-cloud)
# Driver selector: 'mock' | 'meta-cloud'
WHATSAPP_DRIVER=mock
# Meta App Secret — signs webhook payloads (X-Hub-Signature-256)
META_APP_SECRET=
# Permanent / system-user access token for Cloud API calls
META_WA_ACCESS_TOKEN=
# WhatsApp Business Account ID (used by template sync)
META_WA_BUSINESS_ACCOUNT_ID=
# Webhook verify token configured in Meta App dashboard (GET hub.verify_token check)
META_WA_VERIFY_TOKEN=
# Phone Number ID for the WABA sender (client-visible, used in send URL)
NEXT_PUBLIC_WABA_PHONE_ID=

# N-Kolay payment (used when PAYMENT_DRIVER=nkolay)
# Driver selector: 'mock' | 'nkolay'
PAYMENT_DRIVER=mock
# N-Kolay merchant API key
NKOLAY_API_KEY=
# N-Kolay API base URL (e.g. https://api.nkolay.com)
NKOLAY_API_URL=
# N-Kolay HMAC secret for signing requests
NKOLAY_SECRET_KEY=
# N-Kolay sx parameter (merchant-specific)
NKOLAY_SX=

# ---- FEAT-AFFILIATE-WEBHOOK: brand → Hangel sale confirmation webhook (2026-05-18) ----
# HMAC SHA256 secret used as a fallback when a brand has no per-tenant
# `brands/{brandId}.affiliateSecret` configured. Endpoint:
#   POST /api/affiliate/webhook/[brandId]
# Header: `x-affiliate-signature: <hex>` (or `sha256=<hex>`).
# Optional anti-replay header: `x-affiliate-timestamp: <unix-seconds>` (±5min).
AFFILIATE_WEBHOOK_SECRET=

# ---- P1-8b: AI per-user, per-kind, per-day quota caps (2026-05-18) ----
# Override the default 30 calls/user/day per AI flow `kind`. Unset → 30.
# Non-positive-integer values are ignored (warning logged, default used).
# Env key format: AI_QUOTA_<UPPER_SNAKE_CASE_OF_KIND>.
AI_QUOTA_IMPACT_STORY=30
AI_QUOTA_LIBRARY_ASSISTANT=50
AI_QUOTA_MARKETPLACE_ASSISTANT=50
AI_QUOTA_PRODUCT_DESCRIPTION=20
AI_QUOTA_PROJECT_WRITER=10

# ---- PDF-13b: Email contact-import via server-side OAuth (2026-05-21) ----
# Server-side only — NEVER NEXT_PUBLIC_*. Used by:
#   POST /api/contacts/[provider]/start  (provider ∈ google | microsoft)
#   GET  /api/contacts/[provider]/callback
# Setup runbook: docs/audit/runbooks/contacts-oauth-setup.md
#
# Google Cloud → APIs & Services → Credentials → OAuth 2.0 Client ID (Web).
# Enable the "People API". Authorized redirect URI:
#   https://hangel.org.tr/api/contacts/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
#
# Azure Portal → App registrations → your app. API permissions: Microsoft Graph
# delegated "Contacts.Read". Redirect URI (type: Web):
#   https://hangel.org.tr/api/contacts/microsoft/callback
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
# Azure AD tenant. 'common' = personal + work/school accounts. Default: common.
MICROSOFT_TENANT=common
#
# HMAC secret that signs the OAuth `state` token (CSRF protection). Generate a
# random 32+ char value, e.g.:  openssl rand -hex 32
OAUTH_STATE_SECRET=
